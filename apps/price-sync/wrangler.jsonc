{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-07",
	"name": "aritrips-price-sync",
	"main": "src/index.ts",
	"observability": {
		"enabled": true
	},
	// Dos horarios independientes (ver el dispatcher en src/index.ts, que
	// distingue cuál es cuál por el string exacto del cron) para que cada
	// invocación se quede corta y liviana, en vez de una sola que haga
	// vuelos y hoteles junta y arriesgue el límite de 50 subrequests del
	// plan free de Workers:
	//  - */15 * * * * (vuelos, Travelpayouts): 952 rutas, ciclo ~16h.
	//  - 5-59/20 * * * * (hoteles, Xotelo): 40 destinos, ciclo ~1h.
	// Nadie los dispara a mano en el día a día — Cloudflare los despierta
	// solo, más un endpoint /run protegido por secret para probar.
	"triggers": {
		"crons": ["*/15 * * * *", "5-59/20 * * * *"]
	}
}
