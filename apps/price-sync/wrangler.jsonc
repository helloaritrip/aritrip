{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-07",
	"name": "aritrips-price-sync",
	"main": "src/index.ts",
	"observability": {
		"enabled": true
	},
	// Cada 15 min procesa un lote de 15 rutas (ver BATCH_SIZE en
	// src/index.ts, acotado por el límite de 50 subrequests/invocación
	// del plan free de Workers) — con las 952 rutas del catálogo, un
	// ciclo completo tarda ~16 horas y arranca de nuevo, así los precios
	// se mantienen razonablemente frescos de forma continua. Nadie lo
	// dispara a mano en el día a día — Cloudflare lo despierta solo, más
	// un endpoint /run protegido por secret para probar a mano.
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}
