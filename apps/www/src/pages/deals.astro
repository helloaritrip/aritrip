---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import {
  destinations,
  listDocuments,
  generateAllPriceSnapshots,
  detectFlightDeals,
  MIN_DEAL_DISCOUNT_PERCENT,
  ORIGIN_LABELS,
  DEFAULT_PARTNER_CONFIG,
  type LiveFlightPrice,
  type FlightDeal,
  type OriginHub,
} from "@aritrips/data";
import { DealSaveButton } from "../components/DealSaveButton";

// SSR — los precios reales cambian solo (apps/price-sync corre cada 15
// min), así que esta página tiene que leer Firestore en cada visita, no
// quedar prerenderizada. Mismo patrón que /blog y /p/[slug].
export const prerender = false;

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
function imageProxyUrl(query: string, fallback: string): string {
  return `${APP_URL}/api/image-proxy?q=${encodeURIComponent(query)}&fallback=${encodeURIComponent(fallback)}`;
}

const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;
const credentials =
  FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY
    ? { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") }
    : null;

let allDeals: FlightDeal[] = [];
const affiliateIds = { ...DEFAULT_PARTNER_CONFIG };
let loadError: string | null = null;

if (credentials) {
  try {
    const [liveDocs, partnerDocs] = await Promise.all([
      listDocuments("livePrices", credentials),
      listDocuments("partners", credentials),
    ]);

    const livePrices: LiveFlightPrice[] = liveDocs
      .filter(
        (d) =>
          d.id !== "_cursor" &&
          typeof d.destinationId === "string" &&
          typeof d.originAirportCode === "string" &&
          typeof d.avgFlightCostUSD === "number"
      )
      .map((d) => ({
        destinationId: d.destinationId as string,
        originAirportCode: d.originAirportCode as string,
        avgFlightCostUSD: d.avgFlightCostUSD as number,
        avgFlightDurationMinutes: (d.avgFlightDurationMinutes as number) ?? 0,
        capturedAt: (d.capturedAt as string) ?? new Date().toISOString(),
        transfers: typeof d.transfers === "number" ? d.transfers : undefined,
        airline: typeof d.airline === "string" ? d.airline : undefined,
        searchPeriod: typeof d.searchPeriod === "string" ? d.searchPeriod : undefined,
      }));

    for (const doc of partnerDocs) {
      const category = doc.category as keyof typeof affiliateIds;
      if (category in affiliateIds && typeof doc.value === "string" && doc.active !== false) {
        affiliateIds[category] = { ...affiliateIds[category], value: doc.value };
      }
    }

    const curatedSnapshots = generateAllPriceSnapshots(destinations);
    allDeals = detectFlightDeals(livePrices, destinations, curatedSnapshots);
  } catch (err) {
    console.error("[deals] Failed to load deals", err);
    loadError = "Couldn't load current deals right now.";
  }
} else {
  loadError = "Deals aren't configured yet.";
}

// ---------- Tipo de oferta (pestañas) ----------
// Las 3 pestañas muestran los MISMOS deals (la señal real de "esto está
// barato" sigue siendo solo el vuelo, ver deals.ts) — lo que cambia es
// qué se suma al precio mostrado. Hotel/actividades son estimados curados,
// no verificados en vivo, mismo criterio de "estimate" que ya usa
// ResultCard en la app. 5 noches / 1 adulto como supuesto de viaje base,
// igual que el resto del sitio (HOTEL_TRIP_NIGHTS en apps/price-sync).
type DealType = "flight" | "flight-hotel" | "trip";
const DEAL_TYPES: { value: DealType; label: string }[] = [
  { value: "flight", label: "Flight deals" },
  { value: "flight-hotel", label: "Flight and hotel deals" },
  { value: "trip", label: "Trip deals" },
];
const DEFAULT_TYPE: DealType = "flight";
const TRIP_NIGHTS = 5;

function isDealType(v: string | null): v is DealType {
  return v === "flight" || v === "flight-hotel" || v === "trip";
}

const rawType = Astro.url.searchParams.get("type");
const selectedType: DealType = isDealType(rawType) ? rawType : DEFAULT_TYPE;

function displayPriceUSD(deal: FlightDeal, type: DealType): number {
  if (type === "flight") return deal.avgFlightCostUSD;
  if (type === "flight-hotel") return deal.avgFlightCostUSD + deal.hotelPerNightUSD * TRIP_NIGHTS;
  return deal.avgFlightCostUSD + deal.hotelPerNightUSD * TRIP_NIGHTS + deal.activityPerDayUSD * TRIP_NIGHTS;
}

function badgeFor(deal: FlightDeal, type: DealType): string {
  if (deal.discountPercent >= 25) return "🔥 Deal";
  if (type === "flight") return "Round trip";
  if (type === "flight-hotel") return "Flight + Hotel";
  return "Flight + Hotel + Activities";
}

// ---------- Orden ----------
type SortOption = "recent" | "price-asc" | "price-desc";
const SORT_OPTIONS: { value: SortOption; label: string }[] = [
  { value: "recent", label: "Most recent" },
  { value: "price-asc", label: "Price: low to high" },
  { value: "price-desc", label: "Price: high to low" },
];
const DEFAULT_SORT: SortOption = "recent";

function isSortOption(v: string | null): v is SortOption {
  return v === "recent" || v === "price-asc" || v === "price-desc";
}

const rawSort = Astro.url.searchParams.get("sort");
const selectedSort: SortOption = isSortOption(rawSort) ? rawSort : DEFAULT_SORT;

// ---------- Filtros (origen/mes) + orden + paginación vía query params +
// links normales (sin JS) — mismo principio de "0 <script> en páginas
// públicas" que ya rige el resto del sitio. ----------
const selectedOrigin = Astro.url.searchParams.get("origin");
const selectedMonth = Astro.url.searchParams.get("month");

const availableOrigins = Array.from(new Set(allDeals.map((d) => d.originAirportCode))).sort((a, b) =>
  (ORIGIN_LABELS[a] ?? a).localeCompare(ORIGIN_LABELS[b] ?? b)
);
const availableMonths = Array.from(new Set(allDeals.map((d) => d.travelMonth))).sort((a, b) => a - b);

const filteredDeals = allDeals.filter((d) => {
  if (selectedOrigin && d.originAirportCode !== selectedOrigin) return false;
  if (selectedMonth && d.travelMonth !== Number(selectedMonth)) return false;
  return true;
});

const sortedDeals = [...filteredDeals].sort((a, b) => {
  if (selectedSort === "price-asc") return displayPriceUSD(a, selectedType) - displayPriceUSD(b, selectedType);
  if (selectedSort === "price-desc") return displayPriceUSD(b, selectedType) - displayPriceUSD(a, selectedType);
  return new Date(b.capturedAt).getTime() - new Date(a.capturedAt).getTime();
});

const PAGE_SIZE = 9;
const totalPages = Math.max(1, Math.ceil(sortedDeals.length / PAGE_SIZE));
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
const currentPage = Number.isFinite(rawPage) && rawPage >= 1 && rawPage <= totalPages ? rawPage : 1;
const deals = sortedDeals.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

// Cualquier link que cambie origen/mes/pestaña/orden vuelve a la página 1
// (el conjunto de resultados cambia) — solo los links de número de página
// mantienen el resto tal cual y solo pisan `page`.
function buildUrl(overrides: {
  origin?: string | null;
  month?: string | null;
  type?: DealType | null;
  sort?: SortOption | null;
  page?: number | null;
}): string {
  const url = new URLSearchParams();
  const origin = overrides.origin !== undefined ? overrides.origin : selectedOrigin;
  const month = overrides.month !== undefined ? overrides.month : selectedMonth;
  const type = overrides.type !== undefined ? overrides.type : selectedType;
  const sort = overrides.sort !== undefined ? overrides.sort : selectedSort;
  const page = overrides.page !== undefined ? overrides.page : null;
  if (origin) url.set("origin", origin);
  if (month) url.set("month", month);
  if (type && type !== DEFAULT_TYPE) url.set("type", type);
  if (sort && sort !== DEFAULT_SORT) url.set("sort", sort);
  if (page && page > 1) url.set("page", String(page));
  const qs = url.toString();
  return qs ? `/deals?${qs}` : "/deals";
}

const MONTH_NAMES = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

function timeAgo(iso: string): string {
  const diffMs = Date.now() - new Date(iso).getTime();
  const hours = Math.round(diffMs / 3600000);
  if (hours < 1) return "just now";
  if (hours < 48) return `${hours}h ago`;
  return `${Math.round(hours / 24)}d ago`;
}

// No tenemos una fecha exacta (solo mes de viaje) — se ancla al día 15 con
// un viaje de TRIP_NIGHTS noches, mismo criterio que usa apps/price-sync
// para consultar "el próximo mes" en general. El usuario ajusta fechas
// exactas ya en el sitio del partner.
function tripDates(deal: FlightDeal): { checkin: string; checkout: string } {
  const checkin = `${deal.travelYear}-${String(deal.travelMonth).padStart(2, "0")}-15`;
  const checkout = new Date(deal.travelYear, deal.travelMonth - 1, 15 + TRIP_NIGHTS).toISOString().slice(0, 10);
  return { checkin, checkout };
}

function kiwiDealLink(deal: FlightDeal): string {
  const { checkin, checkout } = tripDates(deal);
  const url = new URL("https://www.kiwi.com/deep");
  url.searchParams.set("affilid", affiliateIds.flight.value);
  url.searchParams.set("from", deal.originAirportCode);
  url.searchParams.set("to", deal.destination.airportCodes[0]);
  url.searchParams.set("departure", checkin);
  url.searchParams.set("return", checkout);
  url.searchParams.set("adults", "1");
  return url.toString();
}

function hotelDealLink(deal: FlightDeal): string {
  const { checkin, checkout } = tripDates(deal);
  const url = new URL("https://www.booking.com/searchresults.html");
  url.searchParams.set("ss", deal.destination.name);
  url.searchParams.set("checkin", checkin);
  url.searchParams.set("checkout", checkout);
  url.searchParams.set("group_adults", "1");
  url.searchParams.set("no_rooms", "1");
  if (affiliateIds.hotel.value) url.searchParams.set("aid", affiliateIds.hotel.value);
  return url.toString();
}

function activityDealLink(deal: FlightDeal): string {
  const url = new URL("https://www.klook.com/search/result/");
  url.searchParams.set("query", deal.destination.name);
  url.searchParams.set("aid", affiliateIds.activity.value);
  return url.toString();
}
---

<Layout
  title="Flight Deals — AriTrips"
  description="Real flight, hotel, and trip deals detected automatically by comparing live prices against our own curated cost data — not hand-picked screenshots."
>
  <div class="bg-brand-blue-mid px-6 py-16 text-center text-white">
    <p class="text-sm text-white/70">
      <a href="/" class="hover:text-highlight">Home</a> / Deals
    </p>
    <h1 class="mt-2 text-3xl font-semibold sm:text-4xl">Flight Deals</h1>
    <p class="mx-auto mt-3 max-w-xl text-sm text-white/80">
      Real fares from Travelpayouts, flagged automatically when they run at least {MIN_DEAL_DISCOUNT_PERCENT}% below what that
      route normally costs for that month — no one has to go hunting for these by hand.
    </p>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-14 lg:grid-cols-[260px_1fr]">
    <aside class="flex flex-col gap-8">
      <div class="flex flex-col gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Sort by</h2>
        <ul class="flex flex-col gap-1.5">
          {SORT_OPTIONS.map((opt) => (
            <li>
              <a
                href={buildUrl({ sort: opt.value })}
                class={`block rounded-md px-2.5 py-1.5 text-sm ${
                  selectedSort === opt.value ? "bg-accent/10 font-medium text-accent" : "text-ink hover:bg-bg"
                }`}
              >
                {opt.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Flying from</h2>
          {(selectedOrigin || selectedMonth) && (
            <a href="/deals" class="text-xs font-medium text-accent hover:underline">
              Clear
            </a>
          )}
        </div>
        <ul class="flex flex-col gap-1.5">
          {availableOrigins.map((origin) => (
            <li>
              <a
                href={selectedOrigin === origin ? buildUrl({ origin: null }) : buildUrl({ origin })}
                class={`block rounded-md px-2.5 py-1.5 text-sm ${
                  selectedOrigin === origin ? "bg-accent/10 font-medium text-accent" : "text-ink hover:bg-bg"
                }`}
              >
                {ORIGIN_LABELS[origin] ?? origin}
              </a>
            </li>
          ))}
          {availableOrigins.length === 0 && <li class="text-sm text-muted">No deals yet.</li>}
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Travel month</h2>
        <ul class="flex flex-col gap-1.5">
          {availableMonths.map((month) => (
            <li>
              <a
                href={selectedMonth === String(month) ? buildUrl({ month: null }) : buildUrl({ month: String(month) })}
                class={`block rounded-md px-2.5 py-1.5 text-sm ${
                  selectedMonth === String(month) ? "bg-accent/10 font-medium text-accent" : "text-ink hover:bg-bg"
                }`}
              >
                {MONTH_NAMES[month - 1]}
              </a>
            </li>
          ))}
          {availableMonths.length === 0 && <li class="text-sm text-muted">No deals yet.</li>}
        </ul>
      </div>
    </aside>

    <div class="flex min-w-0 flex-col gap-6">
      {loadError && <p class="rounded-md border border-rule bg-surface p-4 text-sm text-red-600 dark:text-red-400">{loadError}</p>}

      {!loadError && (
        <div class="flex flex-wrap gap-2">
          {DEAL_TYPES.map((t) => (
            <a
              href={buildUrl({ type: t.value })}
              class={`rounded-full border px-4 py-2 text-sm font-medium transition-colors ${
                selectedType === t.value ? "border-accent bg-accent text-accent-ink" : "border-rule text-ink hover:bg-surface"
              }`}
            >
              {t.label}
            </a>
          ))}
        </div>
      )}

      {!loadError && (
        <p class="text-sm text-muted">
          {filteredDeals.length} deal{filteredDeals.length === 1 ? "" : "s"} found right now
          {selectedOrigin ? ` from ${ORIGIN_LABELS[selectedOrigin as OriginHub] ?? selectedOrigin}` : ""}
          {selectedMonth ? ` in ${MONTH_NAMES[Number(selectedMonth) - 1]}` : ""}.
        </p>
      )}

      {!loadError && deals.length === 0 && (
        <div class="rounded-lg border border-dashed border-rule bg-surface/50 p-10 text-center text-sm text-muted">
          No deals detected right now — our price sync runs continuously in the background, so check back soon. New routes get
          checked every few minutes.
        </div>
      )}

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          deals.map((deal) => (
            <div class="flex flex-col overflow-hidden rounded-lg border border-rule bg-surface">
              <div class="relative">
                <img
                  src={deal.destination.imageUrl || imageProxyUrl(deal.destination.imageQuery, deal.destination.name)}
                  alt={`${deal.destination.name}, ${deal.destination.country}`}
                  class="h-40 w-full object-cover"
                  loading="lazy"
                />
                <span
                  class={`absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold ${
                    deal.discountPercent >= 25 ? "bg-highlight text-highlight-ink" : "bg-white/90 text-ink"
                  }`}
                >
                  {badgeFor(deal, selectedType)}
                </span>
                <div class="absolute right-3 top-3">
                  <DealSaveButton
                    client:only="react"
                    dealId={`${deal.destination.id}_${deal.originAirportCode}_${deal.travelYear}-${deal.travelMonth}`}
                    name={deal.destination.name}
                    country={deal.destination.country}
                    imageUrl={deal.destination.imageUrl}
                    imageQuery={deal.destination.imageQuery}
                    priceLabel={`From $${displayPriceUSD(deal, selectedType).toLocaleString()} USD`}
                    originLabel={ORIGIN_LABELS[deal.originAirportCode] ?? deal.originAirportCode}
                    travelLabel={`${MONTH_NAMES[deal.travelMonth - 1]} ${deal.travelYear}`}
                  />
                </div>
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-2 pt-8">
                  <p class="text-[11px] font-medium uppercase tracking-wide text-white/80">
                    {deal.destination.country} · {deal.destination.region}
                  </p>
                  <p class="text-base font-semibold text-white">{deal.destination.name}</p>
                </div>
              </div>

              <div class="flex flex-col gap-2 p-4">
                <div class="flex items-baseline justify-between gap-2">
                  <div>
                    <p class="text-[11px] uppercase tracking-wide text-muted">From</p>
                    <p class="text-xl font-semibold text-accent">
                      ${displayPriceUSD(deal, selectedType).toLocaleString()}
                      <span class="text-xs font-normal text-muted"> USD</span>
                    </p>
                    {selectedType !== "flight" && (
                      <p class="text-[11px] text-muted">
                        Flight + {TRIP_NIGHTS} nights hotel{selectedType === "trip" ? " + activities" : ""} (estimate)
                      </p>
                    )}
                  </div>
                  <p class="text-xs font-medium text-green-700 dark:text-green-400">-{deal.discountPercent}% flight vs. normal</p>
                </div>

                <p class="text-xs text-muted">Updated {timeAgo(deal.capturedAt)}</p>

                <div class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
                  <span>Flying from</span>
                  <span class="rounded-full bg-highlight/10 px-2 py-0.5 font-medium text-highlight">
                    {ORIGIN_LABELS[deal.originAirportCode] ?? deal.originAirportCode}
                  </span>
                </div>

                <p class="text-xs text-muted">
                  Travel: {MONTH_NAMES[deal.travelMonth - 1]} {deal.travelYear}
                  {typeof deal.transfers === "number" && (
                    <>
                      {" "}
                      · {deal.transfers === 0 ? "Nonstop" : `${deal.transfers} stop${deal.transfers > 1 ? "s" : ""}`}
                      {deal.airline ? ` · ${deal.airline}` : ""}
                    </>
                  )}
                </p>

                {selectedType === "flight" && (
                  <a
                    href={kiwiDealLink(deal)}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="mt-1 rounded-md bg-accent px-3 py-2 text-center text-sm font-medium text-accent-ink hover:opacity-90"
                  >
                    See this deal
                  </a>
                )}
                {selectedType === "flight-hotel" && (
                  <div class="mt-1 flex gap-2">
                    <a
                      href={kiwiDealLink(deal)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="flex-1 rounded-md bg-accent px-3 py-2 text-center text-sm font-medium text-accent-ink hover:opacity-90"
                    >
                      ✈ Flight
                    </a>
                    <a
                      href={hotelDealLink(deal)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="flex-1 rounded-md border border-rule px-3 py-2 text-center text-sm font-medium text-ink hover:border-accent hover:text-accent"
                    >
                      🏨 Hotel
                    </a>
                  </div>
                )}
                {selectedType === "trip" && (
                  <div class="mt-1 flex gap-2">
                    <a
                      href={kiwiDealLink(deal)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="flex-1 rounded-md bg-accent px-3 py-2 text-center text-sm font-medium text-accent-ink hover:opacity-90"
                    >
                      ✈ Flight
                    </a>
                    <a
                      href={hotelDealLink(deal)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="flex-1 rounded-md border border-rule px-3 py-2 text-center text-sm font-medium text-ink hover:border-accent hover:text-accent"
                    >
                      🏨 Hotel
                    </a>
                    <a
                      href={activityDealLink(deal)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="flex-1 rounded-md border border-rule px-3 py-2 text-center text-sm font-medium text-ink hover:border-accent hover:text-accent"
                    >
                      🎟 Activities
                    </a>
                  </div>
                )}
                <p class="text-[11px] text-muted">Approximate dates — refine on the booking site.</p>
              </div>
            </div>
          ))
        }
      </div>

      {totalPages > 1 && (
        <nav class="flex items-center justify-center gap-1.5" aria-label="Pagination">
          <a
            href={buildUrl({ page: Math.max(1, currentPage - 1) })}
            aria-disabled={currentPage === 1}
            class={`rounded-md border border-rule px-3 py-1.5 text-sm font-medium ${
              currentPage === 1 ? "pointer-events-none text-muted opacity-50" : "text-ink hover:border-accent hover:text-accent"
            }`}
          >
            ‹ Prev
          </a>
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={buildUrl({ page })}
              class={`rounded-md border px-3 py-1.5 text-sm font-medium ${
                page === currentPage ? "border-accent bg-accent text-accent-ink" : "border-rule text-ink hover:border-accent hover:text-accent"
              }`}
            >
              {page}
            </a>
          ))}
          <a
            href={buildUrl({ page: Math.min(totalPages, currentPage + 1) })}
            aria-disabled={currentPage === totalPages}
            class={`rounded-md border border-rule px-3 py-1.5 text-sm font-medium ${
              currentPage === totalPages
                ? "pointer-events-none text-muted opacity-50"
                : "text-ink hover:border-accent hover:text-accent"
            }`}
          >
            Next ›
          </a>
        </nav>
      )}

      <p class="text-xs text-muted">
        Some links on this page are affiliate links. We may earn a commission at no extra cost to you. Prices are real fares
        pulled from our data provider, compared automatically against our own curated cost baseline — not hand-picked
        screenshots, and not a live quote at the moment you click.
      </p>
    </div>
  </div>
</Layout>
