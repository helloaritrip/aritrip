---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../lib/requireAdminSession";
import { destinations, originBaseCosts, destinationBaseStayCosts, ORIGIN_LABELS, livePriceDocId, type OriginHub } from "@aritrips/data";
import { getCachedCollection, getCachedQuery, getCachedCount } from "../../lib/adminReadCache";

export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;

let liveFlightDocs: Record<string, unknown>[] = [];
let liveHotelDocs: Record<string, unknown>[] = [];
let priceHistoryDocs: Record<string, unknown>[] = [];
let updateCounts = { day: 0, week: 0, month: 0 };
let loadError: string | null = null;

if (FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY) {
  try {
    const credentials = { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") };
    const now = Date.now();
    const dayAgo = new Date(now - 24 * 60 * 60 * 1000).toISOString();
    const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000).toISOString();
    const monthAgo = new Date(now - 30 * 24 * 60 * 60 * 1000).toISOString();
    const [flightDocs, hotelDocs, historyDocs, dayCount, weekCount, monthCount] = await Promise.all([
      getCachedCollection("livePrices", credentials),
      getCachedCollection("liveHotelPrices", credentials),
      // Acotado, no la colección entera (2026-08-19, tras un 429 real de
      // Firestore por agotar la cuota gratis) — priceHistory solo crece,
      // así que un listDocuments sin límite se pone más caro con el
      // tiempo. 3000 más recientes alcanza de sobra para el resumen por
      // ruta que muestra esta página.
      getCachedQuery("priceHistory:recent", "priceHistory", credentials, {
        orderByField: "capturedAt",
        direction: "DESCENDING",
        limit: 3000,
      }),
      // Contador "precios actualizados" (2026-08-23) — cuenta de agregación
      // aparte, no del array de arriba: con el ritmo real de price-sync
      // (varios miles de capturas por día entre las 4 tareas de cron) el
      // tope de 3000 docs de arriba ni siquiera cubre 24h completas, así
      // que "semana" o "mes" saldrían mal si se contaran de ahí.
      getCachedCount("priceHistory:count:24h", "priceHistory", credentials, {
        field: "capturedAt",
        op: "GREATER_THAN_OR_EQUAL",
        value: dayAgo,
      }),
      getCachedCount("priceHistory:count:7d", "priceHistory", credentials, {
        field: "capturedAt",
        op: "GREATER_THAN_OR_EQUAL",
        value: weekAgo,
      }),
      getCachedCount("priceHistory:count:30d", "priceHistory", credentials, {
        field: "capturedAt",
        op: "GREATER_THAN_OR_EQUAL",
        value: monthAgo,
      }),
    ]);
    liveFlightDocs = flightDocs.filter((d) => d.id !== "_cursor");
    liveHotelDocs = hotelDocs.filter((d) => d.id !== "_cursor");
    priceHistoryDocs = historyDocs;
    updateCounts = { day: dayCount, week: weekCount, month: monthCount };
  } catch (err) {
    loadError = err instanceof Error ? err.message : "Failed to load live prices.";
  }
} else {
  loadError = "Firestore isn't configured yet (missing secrets).";
}

// Rango real observado por ruta (2026-08-18, a pedido del usuario: "ya
// sabemos el mínimo... sería interesante manejar el máximo que puede
// valer") — no es un techo teórico, es el mín/máx que efectivamente
// capturamos en `priceHistory` (Travelpayouts + SerpApi combinados) desde
// que esa colección existe. También se agrupa por ventana de anticipación
// (`advanceMonthsBucket`, ver apps/price-sync — sugerencia del "head" del
// usuario de sacar percentiles por 30/60/90 días en vez de un solo ancla).
// Ese campo solo existe en capturas nuevas — capturas viejas quedan sin
// bucket, se cuentan en el total pero no en ningún desglose por ventana.
function percentile(sorted: number[], p: number): number {
  const idx = Math.min(sorted.length - 1, Math.floor((p / 100) * sorted.length));
  return sorted[idx];
}

const pricesByRoute = new Map<string, number[]>();
const pricesByRouteBucket = new Map<string, Map<number, number[]>>();
// Capturas individuales por ruta (2026-08-18, a pedido del usuario: "que
// me muestre en una tabla los datos") — la tabla de detalle en el cliente
// necesita las filas crudas, no solo los agregados. Tope de 60 por ruta
// (más recientes primero) para que una ruta con mucho historial no infle
// el JSON de la página — el resumen (min/max/mediana/por ventana) igual
// se calcula sobre TODAS las capturas, no solo las 60 mostradas.
const capturesByRoute = new Map<
  string,
  { capturedAt: string; price: number; source: string; advanceMonthsBucket: number | null }[]
>();
for (const doc of priceHistoryDocs) {
  if (doc.type !== "flight") continue;
  const price = doc.avgFlightCostUSD as number;
  if (typeof price !== "number" || price <= 0) continue;
  const key = livePriceDocId(doc.destinationId as string, doc.originAirportCode as string);

  const list = pricesByRoute.get(key) ?? [];
  list.push(price);
  pricesByRoute.set(key, list);

  const bucket = doc.advanceMonthsBucket as number | undefined;
  if (typeof bucket === "number") {
    const byBucket = pricesByRouteBucket.get(key) ?? new Map<number, number[]>();
    const bucketList = byBucket.get(bucket) ?? [];
    bucketList.push(price);
    byBucket.set(bucket, bucketList);
    pricesByRouteBucket.set(key, byBucket);
  }

  const captures = capturesByRoute.get(key) ?? [];
  captures.push({
    capturedAt: doc.capturedAt as string,
    price,
    source: (doc.source as string) ?? "provider_api",
    advanceMonthsBucket: typeof bucket === "number" ? bucket : null,
  });
  capturesByRoute.set(key, captures);
}
for (const [key, captures] of capturesByRoute) {
  captures.sort((a, b) => (a.capturedAt < b.capturedAt ? 1 : -1));
  capturesByRoute.set(key, captures.slice(0, 60));
}

const priceRangeByRoute = new Map<
  string,
  {
    min: number;
    max: number;
    count: number;
    p50: number;
    byBucket: { monthsAhead: number; min: number; max: number; count: number }[];
    captures: { capturedAt: string; price: number; source: string; advanceMonthsBucket: number | null }[];
  }
>();
for (const [key, prices] of pricesByRoute) {
  const sorted = [...prices].sort((a, b) => a - b);
  const byBucket = [...(pricesByRouteBucket.get(key) ?? new Map())]
    .map(([monthsAhead, bucketPrices]) => ({
      monthsAhead,
      min: Math.min(...bucketPrices),
      max: Math.max(...bucketPrices),
      count: bucketPrices.length,
    }))
    .sort((a, b) => a.monthsAhead - b.monthsAhead);
  priceRangeByRoute.set(key, {
    min: sorted[0],
    max: sorted[sorted.length - 1],
    count: sorted.length,
    p50: percentile(sorted, 50),
    byBucket,
    captures: capturesByRoute.get(key) ?? [],
  });
}

// Solo los destinos que tienen datos curados (vuelo + hotel) son los que
// el sistema de precios en vivo puede llegar a cubrir — el resto del
// catálogo (si lo hay) no tiene ruta posible en apps/price-sync.
const cityOptions = destinations
  .filter((d) => destinationBaseStayCosts[d.id])
  .map((d) => ({ id: d.id, name: d.name, country: d.country }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Todo lo que el cliente necesita para filtrar/mostrar sin pegarle de
// nuevo a Firestore — el catálogo completo es chico (40 destinos, unas
// pocas centenas de rutas de vuelo como mucho), no hace falta un
// endpoint aparte.
const pageData = {
  cities: cityOptions,
  updateCounts,
  // Rango completo por ruta, sin importar si tiene o no un doc en
  // `livePrices` (2026-08-19, bug real: las rutas cargadas a mano por
  // ?mode=manual-bulk nunca tienen `livePrices` a propósito, pero antes
  // el rango solo se adjuntaba a `liveFlights` — esos 56 precios de Aruba
  // quedaban guardados pero invisibles en esta página). El cliente arma
  // la misma clave con `${destinationId}_${originAirportCode}` para
  // buscar acá tanto en filas con precio en vivo como en las "pendientes".
  priceRanges: Object.fromEntries(priceRangeByRoute),
  liveFlights: liveFlightDocs.map((d) => ({
    destinationId: d.destinationId as string,
    originAirportCode: d.originAirportCode as string,
    originLabel: ORIGIN_LABELS[d.originAirportCode as OriginHub] ?? (d.originAirportCode as string),
    avgFlightCostUSD: d.avgFlightCostUSD as number,
    avgFlightDurationMinutes: d.avgFlightDurationMinutes as number,
    airline: (d.airline as string) ?? "",
    transfers: typeof d.transfers === "number" ? d.transfers : null,
    capturedAt: d.capturedAt as string,
    range: priceRangeByRoute.get(livePriceDocId(d.destinationId as string, d.originAirportCode as string)) ?? null,
  })),
  liveHotels: liveHotelDocs.map((d) => ({
    destinationId: d.destinationId as string,
    budget: typeof d.avgHotelBudgetUSD === "number" ? d.avgHotelBudgetUSD : null,
    mid: d.avgHotelMidUSD as number,
    premium: typeof d.avgHotelPremiumUSD === "number" ? d.avgHotelPremiumUSD : null,
    capturedAt: d.capturedAt as string,
  })),
  originLabels: ORIGIN_LABELS,
  curatedFlights: Object.fromEntries(
    Object.entries(originBaseCosts).map(([destinationId, bases]) => [
      destinationId,
      Object.fromEntries(bases.map((b) => [b.originAirportCode, b.avgFlightCostUSD])),
    ])
  ),
  curatedHotels: Object.fromEntries(
    Object.entries(destinationBaseStayCosts).map(([destinationId, stay]) => [destinationId, stay.avgHotelCostPerNightUSD.mid])
  ),
};
---

<AdminLayout title="Live Prices — AriTrips Admin" session={session} active="live-prices">
  <div class="flex max-w-3xl flex-col gap-8">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-semibold text-ink">Live Prices</h1>
        {!loadError && (
          <div class="flex items-center gap-1.5 rounded-full border border-rule bg-surface px-3 py-1">
            <span id="update-count" class="text-sm font-semibold text-accent">{updateCounts.day.toLocaleString()}</span>
            <span class="text-xs text-muted">prices updated in the last</span>
            <select
              id="update-range"
              class="rounded-md border-none bg-transparent text-xs font-medium text-ink focus:outline focus:outline-2 focus:outline-accent"
            >
              <option value="day">24 hours</option>
              <option value="week">week</option>
              <option value="month">month</option>
            </select>
          </div>
        )}
      </div>
      <p class="text-sm text-muted">
        Real flight and hotel prices fetched automatically by apps/price-sync, and when each one was last refreshed.
        Search a city to see just that city — {cityOptions.length} destinations tracked, {liveFlightDocs.length} live
        flight prices, {liveHotelDocs.length} live hotel prices right now.
      </p>
    </div>

    {loadError && <p class="rounded-md border border-rule bg-surface p-4 text-sm text-red-600 dark:text-red-400">{loadError}</p>}

    <div class="relative">
      <input
        id="city-search"
        type="text"
        autocomplete="off"
        placeholder="Type a city, or click to see all 40..."
        class="w-full rounded-md border border-rule bg-surface px-3 py-2 pr-8 text-ink placeholder:text-muted focus:outline focus:outline-2 focus:outline-accent"
      />
      <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true">▾</span>
      <div
        id="city-dropdown"
        class="absolute left-0 right-0 top-full z-10 mt-1 hidden max-h-72 overflow-y-auto rounded-md border border-rule bg-surface shadow-lg"
      >
      </div>
    </div>

    <div id="empty-state" class="rounded-lg border border-dashed border-rule bg-surface/50 p-8 text-center text-sm text-muted">
      Search a city above to see its live pricing data.
    </div>

    <div id="city-result" class="hidden flex-col gap-6">
      <div>
        <h2 id="city-result-name" class="text-xl font-semibold text-ink"></h2>
        <p id="city-result-country" class="text-sm text-muted"></p>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">Hotel</h3>
        <div id="hotel-result"></div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">Flights</h3>
        <div id="flights-result" class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface"></div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">Log a price you found</h3>
        <p class="text-xs text-muted">
          Checked a real price on Kiwi, Google Flights, etc.? Log it here — it feeds the same history table above (tagged "Manual"),
          it never overwrites the live price shown to visitors.
        </p>
        <form id="manual-price-form" class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-4">
          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 text-xs text-muted">
              Origin
              <select id="manual-origin" class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink"></select>
            </label>
            <label class="flex flex-col gap-1 text-xs text-muted">
              Departure date
              <input id="manual-date" type="date" class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-muted">
              Price (USD, round trip)
              <input id="manual-price" type="number" min="1" max="20000" step="1" class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-muted">
              Site
              <input
                id="manual-site"
                type="text"
                placeholder="Kiwi, Google Flights..."
                maxlength="40"
                class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink"
              />
            </label>
          </div>
          <label class="flex flex-col gap-1 text-xs text-muted">
            Note (optional)
            <input id="manual-note" type="text" maxlength="200" class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
          </label>
          <div class="flex items-center gap-3">
            <button type="submit" class="rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-white hover:opacity-90">
              Save price
            </button>
            <p id="manual-status" class="text-xs text-muted"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script type="application/json" id="prices-data" is:inline set:html={JSON.stringify(pageData).replace(/</g, "\\u003c")} />

<script>
  type City = { id: string; name: string; country: string };
  type PriceRange = {
    min: number;
    max: number;
    count: number;
    p50: number;
    byBucket: { monthsAhead: number; min: number; max: number; count: number }[];
    captures: { capturedAt: string; price: number; source: string; advanceMonthsBucket: number | null }[];
  };
  type LiveFlight = {
    destinationId: string;
    originAirportCode: string;
    originLabel: string;
    avgFlightCostUSD: number;
    avgFlightDurationMinutes: number;
    airline: string;
    transfers: number | null;
    capturedAt: string;
    range: PriceRange | null;
  };
  type LiveHotel = { destinationId: string; budget: number | null; mid: number; premium: number | null; capturedAt: string };
  type PageData = {
    cities: City[];
    updateCounts: { day: number; week: number; month: number };
    priceRanges: Record<string, PriceRange>;
    liveFlights: LiveFlight[];
    liveHotels: LiveHotel[];
    originLabels: Record<string, string>;
    curatedFlights: Record<string, Record<string, number>>;
    curatedHotels: Record<string, number>;
  };

  const dataEl = document.getElementById("prices-data");
  const data: PageData = JSON.parse(dataEl?.textContent || "{}");

  const searchInput = document.getElementById("city-search") as HTMLInputElement;
  const dropdown = document.getElementById("city-dropdown") as HTMLDivElement;
  const emptyState = document.getElementById("empty-state") as HTMLDivElement;
  const resultPanel = document.getElementById("city-result") as HTMLDivElement;
  const resultName = document.getElementById("city-result-name") as HTMLHeadingElement;
  const resultCountry = document.getElementById("city-result-country") as HTMLParagraphElement;
  const hotelResult = document.getElementById("hotel-result") as HTMLDivElement;
  const flightsResult = document.getElementById("flights-result") as HTMLDivElement;
  const manualForm = document.getElementById("manual-price-form") as HTMLFormElement;
  const manualOrigin = document.getElementById("manual-origin") as unknown as HTMLSelectElement;
  const manualDate = document.getElementById("manual-date") as HTMLInputElement;
  const manualPrice = document.getElementById("manual-price") as HTMLInputElement;
  const manualSite = document.getElementById("manual-site") as HTMLInputElement;
  const manualNote = document.getElementById("manual-note") as HTMLInputElement;
  const manualStatus = document.getElementById("manual-status") as HTMLParagraphElement;
  let selectedCityId: string | null = null;

  const updateCountEl = document.getElementById("update-count") as HTMLSpanElement | null;
  const updateRangeSelect = document.getElementById("update-range") as HTMLSelectElement | null;
  updateRangeSelect?.addEventListener("change", () => {
    const range = updateRangeSelect.value as keyof PageData["updateCounts"];
    if (updateCountEl) updateCountEl.textContent = data.updateCounts[range].toLocaleString();
  });

  function timeAgo(iso: string): string {
    const diffMs = Date.now() - new Date(iso).getTime();
    const mins = Math.round(diffMs / 60000);
    if (mins < 1) return "just now";
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.round(mins / 60);
    if (hours < 48) return `${hours}h ago`;
    return `${Math.round(hours / 24)}d ago`;
  }

  function renderDropdown(matches: City[]) {
    if (matches.length === 0) {
      dropdown.classList.add("hidden");
      dropdown.innerHTML = "";
      return;
    }
    // Sin tope — antes cortaba en 8 resultados, así que escribiendo poco
    // o nada no se podía ver el resto del catálogo. El contenedor ya
    // scrollea (max-h-72 overflow-y-auto), así que mostrar las 40 no
    // rompe el layout.
    dropdown.innerHTML = matches
      .map(
        (c) => `
        <button type="button" data-city-id="${c.id}" class="city-option flex w-full flex-col gap-0.5 px-3 py-2 text-left hover:bg-bg">
          <span class="text-sm font-medium text-ink">${c.name}</span>
          <span class="text-xs text-muted">${c.country}</span>
        </button>`
      )
      .join("");
    dropdown.classList.remove("hidden");
    dropdown.querySelectorAll<HTMLButtonElement>(".city-option").forEach((btn) => {
      btn.addEventListener("click", () => selectCity(btn.dataset.cityId!));
    });
  }

  // Sin esto, tipear "cancun" (sin tilde, lo natural al escribir rápido)
  // no encontraba "Cancún" — normalize + strip de diacríticos hace que
  // la búsqueda ignore tildes en los dos lados de la comparación.
  function normalize(s: string): string {
    return s
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase();
  }

  // Devuelve las ciudades que coinciden con lo tipeado, o el catálogo
  // completo (ya ordenado alfabéticamente) si el campo está vacío — así
  // el mismo input funciona como buscador predictivo Y como dropdown
  // para ver las 40 ciudades de una, a pedido del usuario (2026-08-10).
  function matchesForCurrentValue(): City[] {
    const q = normalize(searchInput.value.trim());
    if (!q) return data.cities;
    return data.cities.filter((c) => normalize(c.name).includes(q) || normalize(c.country).includes(q));
  }

  searchInput.addEventListener("input", () => renderDropdown(matchesForCurrentValue()));
  searchInput.addEventListener("focus", () => renderDropdown(matchesForCurrentValue()));

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) return;
    if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });

  function selectCity(cityId: string) {
    const city = data.cities.find((c) => c.id === cityId);
    if (!city) return;

    selectedCityId = cityId;
    manualStatus.textContent = "";

    const originsForCity = Object.keys(data.curatedFlights[cityId] || {}).sort((a, b) =>
      (data.originLabels[a] || a).localeCompare(data.originLabels[b] || b)
    );
    manualOrigin.innerHTML = originsForCity.map((o) => `<option value="${o}">${data.originLabels[o] || o}</option>`).join("");

    searchInput.value = city.name;
    dropdown.classList.add("hidden");
    emptyState.classList.add("hidden");
    resultPanel.classList.remove("hidden");
    resultPanel.classList.add("flex");

    resultName.textContent = city.name;
    resultCountry.textContent = city.country;

    const hotel = data.liveHotels.find((h) => h.destinationId === cityId);
    const curatedHotel = data.curatedHotels[cityId];
    if (hotel) {
      const diff = curatedHotel ? Math.round(((hotel.mid - curatedHotel) / curatedHotel) * 100) : null;
      const tierRows = (
        [
          ["Budget", hotel.budget],
          ["Mid", hotel.mid],
          ["Premium", hotel.premium],
        ] as [string, number | null][]
      )
        .filter(([, price]) => price !== null)
        .map(([label, price]) => `<span class="mr-3">${label}: <span class="font-medium text-ink">$${price}</span></span>`)
        .join("");
      hotelResult.innerHTML = `
        <div class="flex items-center justify-between rounded-lg border border-rule bg-surface p-4">
          <div>
            <p class="text-lg font-semibold text-accent">$${hotel.mid}<span class="text-sm font-normal text-muted"> / night (mid)</span></p>
            <p class="text-xs text-muted">${tierRows}</p>
            ${diff !== null ? `<p class="text-xs text-muted">${diff >= 0 ? "+" : ""}${diff}% vs. curated estimate ($${curatedHotel}/night)</p>` : ""}
          </div>
          <p class="text-xs text-muted">Refreshed ${timeAgo(hotel.capturedAt)}</p>
        </div>`;
    } else {
      hotelResult.innerHTML = `<div class="rounded-lg border border-dashed border-rule bg-surface/50 p-4 text-sm text-muted">
        No live hotel price yet — still using the curated estimate${curatedHotel ? ` ($${curatedHotel}/night)` : ""}.
      </div>`;
    }

    const flights = data.liveFlights.filter((f) => f.destinationId === cityId).sort((a, b) => a.originLabel.localeCompare(b.originLabel));
    const curatedForCity = data.curatedFlights[cityId] || {};
    const routesWithoutLiveData = Object.keys(curatedForCity).filter((origin) => !flights.some((f) => f.originAirportCode === origin));

    if (flights.length === 0 && routesWithoutLiveData.length === 0) {
      flightsResult.innerHTML = `<p class="p-4 text-sm text-muted">No flight routes tracked for this destination.</p>`;
    } else {
      const sourceLabel = (s: string) => (s === "serpapi" ? "SerpApi" : s === "manual" ? "Manual" : "Travelpayouts");
      const bucketLabel = (b: number | null) => (b === null ? "—" : `~${b * 30}d`);
      const formatCapturedAt = (iso: string) => new Date(iso).toISOString().slice(0, 16).replace("T", " ");

      function capturesTableHtml(range: PriceRange, originLabel: string): string {
        const tableRows = range.captures
          .map(
            (c) => `
            <tr class="border-t border-rule">
              <td class="py-1.5 pr-3 text-xs text-muted">${formatCapturedAt(c.capturedAt)}</td>
              <td class="py-1.5 pr-3 text-xs text-muted">${sourceLabel(c.source)}</td>
              <td class="py-1.5 pr-3 text-xs text-muted">${bucketLabel(c.advanceMonthsBucket)}</td>
              <td class="py-1.5 text-xs font-medium text-ink">$${c.price}</td>
            </tr>`
          )
          .join("");
        return `
          <div class="border-t border-rule bg-bg/50 px-4 pb-4 pt-3">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">
              ${originLabel} → ${resultName.textContent} — min $${range.min} · median $${range.p50} · max $${range.max} (${range.count} captures)
            </p>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[400px] border-collapse text-left">
                <thead>
                  <tr>
                    <th class="pb-1.5 pr-3 text-xs font-semibold uppercase tracking-wide text-muted">Captured</th>
                    <th class="pb-1.5 pr-3 text-xs font-semibold uppercase tracking-wide text-muted">Source</th>
                    <th class="pb-1.5 pr-3 text-xs font-semibold uppercase tracking-wide text-muted">Window</th>
                    <th class="pb-1.5 text-xs font-semibold uppercase tracking-wide text-muted">Price</th>
                  </tr>
                </thead>
                <tbody>${tableRows}</tbody>
              </table>
            </div>
          </div>`;
      }

      // Cada ruta es un <details> (2026-08-18, a pedido del usuario: "haga
      // clic en atlanta y me muestre en una tabla los datos") — clic
      // expande una tabla con cada captura individual de priceHistory
      // (fecha, fuente, ventana de anticipación, precio), no solo el
      // resumen que ya se ve en la fila. Nativo, sin JS extra para el
      // toggle en sí (mismo patrón que FAQAccordion en el resto del sitio).
      const liveRows = flights
        .map((f) => {
          const summaryRow = `
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 [&::-webkit-details-marker]:hidden">
            <div>
              <p class="text-sm font-medium text-ink">${f.originLabel}</p>
              <p class="text-xs text-muted">${f.airline ? f.airline + " · " : ""}${Math.round(f.avgFlightDurationMinutes)} min${
                f.transfers === null ? "" : f.transfers === 0 ? " · Nonstop" : ` · ${f.transfers} stop${f.transfers > 1 ? "s" : ""}`
              }</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-semibold text-accent">$${f.avgFlightCostUSD}</p>
              ${
                f.range && f.range.count >= 2
                  ? `<p class="text-xs text-muted">Observed $${f.range.min}–$${f.range.max}, median $${f.range.p50} (${f.range.count} captures)</p>`
                  : ""
              }
              ${
                f.range && f.range.byBucket.length >= 2
                  ? `<p class="text-xs text-muted">${f.range.byBucket
                      .map((b) => `~${b.monthsAhead * 30}d: $${b.min}${b.max !== b.min ? `–$${b.max}` : ""}`)
                      .join(" · ")}</p>`
                  : ""
              }
              <p class="text-xs text-muted">Refreshed ${timeAgo(f.capturedAt)}</p>
            </div>
          </summary>`;

          if (!f.range || f.range.captures.length === 0) {
            return `<details class="group">${summaryRow}</details>`;
          }
          return `<details class="group">${summaryRow}${capturesTableHtml(f.range, f.originLabel)}</details>`;
        })
        .join("");

      // Rutas sin doc en `livePrices` (2026-08-19, bug real encontrado por
      // el usuario: los 56 precios cargados a mano por ?mode=manual-bulk
      // quedaban invisibles acá) — ahora también buscan en
      // `data.priceRanges` y, si hay algo, se muestran igual que una fila
      // en vivo (con su tabla de detalle), solo que sin el precio "actual"
      // grande arriba porque no hay ningún capturedAt que sea "el más
      // reciente en vivo" — el rango observado es el dato real que importa.
      const pendingRows = routesWithoutLiveData
        .sort((a, b) => (data.originLabels[a] || a).localeCompare(data.originLabels[b] || b))
        .map((origin) => {
          const originLabel = data.originLabels[origin] || origin;
          const range = data.priceRanges[`${cityId}_${origin}`];
          if (!range) {
            return `
        <div class="flex items-center justify-between gap-3 p-4 opacity-60">
          <p class="text-sm text-ink">${originLabel}</p>
          <p class="text-xs text-muted">No live price yet — curated $${curatedForCity[origin]}</p>
        </div>`;
          }
          const summaryRow = `
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 opacity-80 [&::-webkit-details-marker]:hidden">
            <p class="text-sm text-ink">${originLabel}</p>
            <div class="text-right">
              <p class="text-xs text-muted">No live price yet — curated $${curatedForCity[origin]}</p>
              <p class="text-xs text-muted">Observed $${range.min}–$${range.max}, median $${range.p50} (${range.count} captures)</p>
            </div>
          </summary>`;
          return `<details class="group">${summaryRow}${capturesTableHtml(range, originLabel)}</details>`;
        })
        .join("");
      flightsResult.innerHTML = liveRows + pendingRows;
    }
  }

  manualForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!selectedCityId) return;

    const price = Number(manualPrice.value);
    if (!manualOrigin.value || !manualDate.value || !Number.isFinite(price) || price <= 0) {
      manualStatus.textContent = "Fill in origin, date, and price.";
      return;
    }
    if (!manualSite.value.trim()) {
      manualStatus.textContent = "Which site did you check? (e.g. Kiwi, Google Flights)";
      return;
    }

    manualStatus.textContent = "Saving...";
    try {
      const res = await fetch("/api/admin/manual-price", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          destinationId: selectedCityId,
          originAirportCode: manualOrigin.value,
          price,
          departureDate: manualDate.value,
          sourceSite: manualSite.value.trim(),
          note: manualNote.value.trim(),
        }),
      });
      const result = (await res.json()) as { error?: string };
      if (!res.ok) {
        manualStatus.textContent = result.error || "Couldn't save — try again.";
        return;
      }
      manualStatus.textContent = "Saved! Refresh the page to see it in the table above.";
      manualPrice.value = "";
      manualNote.value = "";
    } catch {
      manualStatus.textContent = "Couldn't save — check your connection and try again.";
    }
  });
</script>
