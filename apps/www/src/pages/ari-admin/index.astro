---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../lib/requireAdminSession";

export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect("/ari-admin/login");
}
---

<AdminLayout title="Dashboard — AriTrips Admin" session={session} active={null}>
  <div class="flex max-w-xl flex-col gap-3">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">Welcome back</p>
    <h1 class="text-2xl font-semibold text-ink">{session.email}</h1>
    <p class="text-sm leading-relaxed text-muted">
      Use the sidebar to edit pages, update partner links, or manage who can log into this panel.
      Sections marked "Soon" are reserved for when Ari Core v2 and built-in analytics land — the nav
      won't need a redesign when that happens.
    </p>
  </div>
</AdminLayout>
