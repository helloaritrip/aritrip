---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../lib/requireAdminSession";
import { queryDocuments, countDocuments, destinations, ORIGIN_LABELS, type OriginHub } from "@aritrips/data";

export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;

type TrackedEventDoc = {
  id: string;
  name?: string;
  createdAt?: string;
  searchId?: string;
  originAirportCode?: string;
  budgetUSD?: number;
  destinationId?: string;
  rank?: number;
  finalScore?: number;
  category?: string;
  isTest?: boolean;
  itemType?: string;
  itemId?: string;
};

const PAGE_SIZE = 20;
const requestedPage = Number(Astro.url.searchParams.get("page"));
const page = Number.isFinite(requestedPage) && requestedPage >= 1 ? Math.floor(requestedPage) : 1;

// Muestra para las estadísticas agregadas (top orígenes/destinos, CTR) —
// separada de la actividad paginada de abajo porque esas cards tienen
// que reflejar "los últimos N eventos" en conjunto, no solo la página
// que se esté mirando en un momento dado.
const STATS_SAMPLE_SIZE = 300;

let statsEvents: TrackedEventDoc[] = [];
let pageEvents: TrackedEventDoc[] = [];
let totalEvents = 0;
let loadError: string | null = null;

if (FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY) {
  try {
    const credentials = { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") };
    // orderBy real (2026-08-10) — antes esto usaba listDocuments, que no
    // garantiza ningún orden y se corta en los primeros 300 documentos
    // que Firestore devuelva; una vez la colección creciera más allá de
    // eso, "reciente" podía dejar de ser cierto sin que nadie lo notara.
    [statsEvents, pageEvents, totalEvents] = await Promise.all([
      queryDocuments("events", credentials, { orderByField: "createdAt", direction: "DESCENDING", limit: STATS_SAMPLE_SIZE }) as Promise<
        TrackedEventDoc[]
      >,
      queryDocuments("events", credentials, {
        orderByField: "createdAt",
        direction: "DESCENDING",
        limit: PAGE_SIZE,
        offset: (page - 1) * PAGE_SIZE,
      }) as Promise<TrackedEventDoc[]>,
      countDocuments("events", credentials),
    ]);
  } catch (err) {
    console.error("[searches] Failed to load events", err);
    loadError = "Couldn't load search data right now.";
  }
} else {
  loadError = "Firestore isn't configured yet (missing secrets).";
}

const totalPages = Math.max(1, Math.ceil(totalEvents / PAGE_SIZE));

const destinationName = (id?: string) => destinations.find((d) => d.id === id)?.name ?? id ?? "—";
const originLabel = (code?: string) => ORIGIN_LABELS[code as OriginHub] ?? code ?? "—";

// isTest (2026-08-11) — se excluye de TODOS los números de acá para abajo.
// Las propias pruebas de QA (y las del founder probando desde su PC)
// generaban búsquedas indistinguibles de las de un visitante real, y el
// objetivo de Fase 2 es justamente contar visitantes reales. La
// "Actividad reciente" paginada de más abajo sí las sigue mostrando (con
// una etiqueta), para no perder la trazabilidad de qué se marcó como
// prueba y cuándo — ver testMode.ts en apps/app.
const testEventsInSample = statsEvents.filter((e) => e.isTest === true).length;
const realStatsEvents = statsEvents.filter((e) => e.isTest !== true);

const searches = realStatsEvents.filter((e) => e.name === "search_performed");
const shown = realStatsEvents.filter((e) => e.name === "recommendation_shown");
const clicked = realStatsEvents.filter((e) => e.name === "recommendation_clicked");
// Último eslabón del funnel (2026-08-15) — favorite_saved/removed, ver
// SaveButton.tsx/DealSaveButton.tsx. Se cuenta net saves (guardados menos
// quitados), no solo guardados, para no inflar el número con gente que
// guarda y se arrepiente al toque.
const favoriteSaves = realStatsEvents.filter((e) => e.name === "favorite_saved");
const favoriteRemoves = realStatsEvents.filter((e) => e.name === "favorite_removed");
const netFavorites = favoriteSaves.length - favoriteRemoves.length;
const roughFavoriteRate = shown.length > 0 ? Math.round((favoriteSaves.length / shown.length) * 1000) / 10 : null;

// CTR aproximado — sin un searchId compartido entre eventos todavía no
// se puede saber con certeza si un click pertenece a una búsqueda
// puntual, así que esto es una razón agregada (clicks totales / vistas
// totales), no "por búsqueda". Suficiente para una primera lectura de
// tendencia; una versión por-búsqueda real necesita ese searchId.
const roughCTR = shown.length > 0 ? Math.round((clicked.length / shown.length) * 1000) / 10 : null;

function topCounts<T extends string>(items: T[], limit = 8): { key: T; count: number }[] {
  const counts = new Map<T, number>();
  for (const item of items) counts.set(item, (counts.get(item) ?? 0) + 1);
  return [...counts.entries()]
    .map(([key, count]) => ({ key, count }))
    .sort((a, b) => b.count - a.count)
    .slice(0, limit);
}

const topOrigins = topCounts(searches.map((e) => e.originAirportCode ?? "unknown"));
const topShown = topCounts(shown.map((e) => e.destinationId ?? "unknown"));
const topClicked = topCounts(clicked.map((e) => e.destinationId ?? "unknown"));
// itemId: para itemType "destination" es un destinationId (nombre real
// disponible); para "deal" es un id compuesto (destinationId_origen_mes,
// ver deals.astro) — se muestra el destinationId (primer segmento) tal
// cual para no armar un lookup nuevo solo para esto.
const topFavorited = topCounts(favoriteSaves.map((e) => e.itemId?.split("_")[0] ?? "unknown"));

const avgBudget =
  searches.length > 0
    ? Math.round(searches.reduce((sum, e) => sum + (typeof e.budgetUSD === "number" ? e.budgetUSD : 0), 0) / searches.length)
    : null;

// Acceptance Rate, con searchId real (2026-08-10) — para cada búsqueda,
// se une "qué se mostró" con "qué se clickeó primero" y se compara contra
// el puntaje del #1, no solo si ganó o no. Un click en el #2 con un
// puntaje casi idéntico al #1 es una señal sana (dos opciones parecidas,
// el usuario eligió por gusto); un click en un puntaje mucho más bajo que
// el #1 es la señal real de que el scoring podría estar mal calibrado —
// el "% de veces que gana el #1" solo, sin esto, puede confundirse con
// puro sesgo de posición (la gente clickea lo primero que ve).
type ShownEntry = { rank: number; finalScore: number };
const shownBySearch = new Map<string, ShownEntry[]>();
const clicksBySearch = new Map<string, { rank: number; createdAt: string }[]>();

for (const e of realStatsEvents) {
  if (e.name === "recommendation_shown" && e.searchId && typeof e.rank === "number" && typeof e.finalScore === "number") {
    const arr = shownBySearch.get(e.searchId) ?? [];
    arr.push({ rank: e.rank, finalScore: e.finalScore });
    shownBySearch.set(e.searchId, arr);
  }
  if (e.name === "recommendation_clicked" && e.searchId && typeof e.rank === "number") {
    const arr = clicksBySearch.get(e.searchId) ?? [];
    arr.push({ rank: e.rank, createdAt: e.createdAt ?? "" });
    clicksBySearch.set(e.searchId, arr);
  }
}

type SearchOutcome = { firstClickRank: number; rank1Score: number; clickedScore: number };
const outcomes: SearchOutcome[] = [];

for (const [searchId, clicks] of clicksBySearch) {
  const shownList = shownBySearch.get(searchId);
  if (!shownList) continue;
  const rank1 = shownList.find((s) => s.rank === 1);
  // Sin el #1 en lo que se trajo, la muestra está incompleta para esta
  // búsqueda (puede haber quedado cortada en el borde de STATS_SAMPLE_SIZE)
  // — se descarta en vez de mostrar un número engañoso.
  if (!rank1) continue;

  const firstClick = [...clicks].sort((a, b) => a.createdAt.localeCompare(b.createdAt))[0];
  const clickedShown = shownList.find((s) => s.rank === firstClick.rank);
  if (!clickedShown) continue;

  outcomes.push({ firstClickRank: firstClick.rank, rank1Score: rank1.finalScore, clickedScore: clickedShown.finalScore });
}

const MIN_OUTCOMES_FOR_CONFIDENCE = 5;
const totalOutcomes = outcomes.length;
const acceptancePct = (predicate: (o: SearchOutcome) => boolean) =>
  totalOutcomes > 0 ? Math.round((outcomes.filter(predicate).length / totalOutcomes) * 1000) / 10 : null;

const rank1Pct = acceptancePct((o) => o.firstClickRank === 1);
const rank2Pct = acceptancePct((o) => o.firstClickRank === 2);
const rank3PlusPct = acceptancePct((o) => o.firstClickRank >= 3);

const notRank1 = outcomes.filter((o) => o.firstClickRank !== 1);
const avgScoreGap =
  notRank1.length > 0
    ? Math.round((notRank1.reduce((sum, o) => sum + (o.rank1Score - o.clickedScore), 0) / notRank1.length) * 10) / 10
    : null;

// Desgloses de Fase 2 (2026-08-11, roadmap acordado con el head de
// producto) — CTR real por rank/destino/categoría, más por
// origen/presupuesto vía searchId (solo eventos con searchId, que existe
// desde 2026-08-10 — los más viejos quedan afuera de estos 2, mismo límite
// que ya tiene Acceptance Rate arriba).
function ctrRows<T extends string | number>(shownItems: T[], clickedItems: T[], limit = 8): { key: T; shown: number; clicked: number; ctr: number | null }[] {
  const shownCounts = new Map<T, number>();
  for (const k of shownItems) shownCounts.set(k, (shownCounts.get(k) ?? 0) + 1);
  const clickedCounts = new Map<T, number>();
  for (const k of clickedItems) clickedCounts.set(k, (clickedCounts.get(k) ?? 0) + 1);

  const keys = new Set([...shownCounts.keys(), ...clickedCounts.keys()]);
  return [...keys]
    .map((key) => {
      const shownCount = shownCounts.get(key) ?? 0;
      const clickedCount = clickedCounts.get(key) ?? 0;
      return { key, shown: shownCount, clicked: clickedCount, ctr: shownCount > 0 ? Math.round((clickedCount / shownCount) * 1000) / 10 : null };
    })
    .sort((a, b) => b.shown - a.shown)
    .slice(0, limit);
}

// rank ya viene directo en shown/clicked, sin necesidad de join.
const ctrByRank = ctrRows(
  shown.filter((e) => typeof e.rank === "number").map((e) => e.rank as number),
  clicked.filter((e) => typeof e.rank === "number").map((e) => e.rank as number)
).sort((a, b) => (a.key as number) - (b.key as number));

const ctrByDestination = ctrRows(
  shown.map((e) => e.destinationId ?? "unknown"),
  clicked.map((e) => e.destinationId ?? "unknown")
);

// Categoría solo existe en clicked (no tiene sentido un "shown" por
// categoría — se muestran las 5 categorías siempre, en cada card) así que
// esto es distribución de clicks, no un CTR.
const clicksByCategory = topCounts(clicked.map((e) => e.category ?? "unknown"), 6);

// origin/budget necesitan el contexto de la búsqueda (searchId ->
// origin/budget), que solo vive en el evento search_performed.
const searchContext = new Map<string, { originAirportCode?: string; budgetUSD?: number }>();
for (const e of realStatsEvents) {
  if (e.name === "search_performed" && e.searchId) {
    searchContext.set(e.searchId, { originAirportCode: e.originAirportCode, budgetUSD: e.budgetUSD });
  }
}

const shownWithContext = shown.filter((e) => e.searchId && searchContext.has(e.searchId));
const clickedWithContext = clicked.filter((e) => e.searchId && searchContext.has(e.searchId));

const ctrByOrigin = ctrRows(
  shownWithContext.map((e) => searchContext.get(e.searchId!)!.originAirportCode ?? "unknown"),
  clickedWithContext.map((e) => searchContext.get(e.searchId!)!.originAirportCode ?? "unknown")
);

function budgetTier(budget: number | undefined): string {
  if (typeof budget !== "number") return "unknown";
  if (budget < 1000) return "< $1,000";
  if (budget < 2000) return "$1,000–1,999";
  if (budget < 3000) return "$2,000–2,999";
  if (budget < 5000) return "$3,000–4,999";
  return "$5,000+";
}
const BUDGET_TIER_ORDER = ["< $1,000", "$1,000–1,999", "$2,000–2,999", "$3,000–4,999", "$5,000+", "unknown"];
const ctrByBudget = ctrRows(
  shownWithContext.map((e) => budgetTier(searchContext.get(e.searchId!)!.budgetUSD)),
  clickedWithContext.map((e) => budgetTier(searchContext.get(e.searchId!)!.budgetUSD)),
  BUDGET_TIER_ORDER.length
).sort((a, b) => BUDGET_TIER_ORDER.indexOf(a.key as string) - BUDGET_TIER_ORDER.indexOf(b.key as string));

const eventsWithSearchId = realStatsEvents.filter((e) => e.searchId).length;
const breakdownCoveragePct = realStatsEvents.length > 0 ? Math.round((eventsWithSearchId / realStatsEvents.length) * 100) : 0;

function formatEvent(e: TrackedEventDoc): string {
  if (e.name === "search_performed") return `${originLabel(e.originAirportCode)} · $${(e.budgetUSD ?? 0).toLocaleString()}`;
  if (e.name === "recommendation_shown") return `${destinationName(e.destinationId)} · rank #${e.rank} · score ${e.finalScore}`;
  if (e.name === "recommendation_clicked") return `${destinationName(e.destinationId)} · ${e.category}`;
  if (e.name === "favorite_saved" || e.name === "favorite_removed") {
    return `${destinationName(e.itemId?.split("_")[0])} · ${e.itemType ?? "?"}`;
  }
  return "—";
}

function formatDate(iso?: string): string {
  if (!iso) return "—";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "—";
  return d.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
}

const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<AdminLayout title="Searches — AriTrips Admin" session={session} active="searches">
  <div class="flex max-w-4xl flex-col gap-8">
    <div>
      <h1 class="text-2xl font-semibold text-ink">Searches</h1>
      <p class="text-sm text-muted">
        Lo que la gente busca de verdad, y qué eligió — {searches.length} búsquedas, {shown.length} recomendaciones
        mostradas, {clicked.length} clicks y {netFavorites} favoritos guardados hasta ahora.
      </p>
      {testEventsInSample > 0 && (
        <p class="text-xs text-muted">
          Excluidos {testEventsInSample} eventos marcados como prueba (QA, o visitas propias con{" "}
          <code class="rounded bg-surface-2 px-1 py-0.5">?test=1</code>) — no cuentan para estos números.
        </p>
      )}
    </div>

    {loadError && <p class="rounded-md border border-rule bg-surface p-4 text-sm text-red-600 dark:text-red-400">{loadError}</p>}

    {!loadError && totalEvents === 0 && (
      <div class="rounded-lg border border-dashed border-rule bg-surface/50 p-8 text-center text-sm text-muted">
        Todavía no hay datos — van a empezar a aparecer acá apenas alguien use el buscador.
      </div>
    )}

    {totalEvents > 0 && (
      <>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-5">
          <div class="rounded-lg border border-rule bg-surface p-4">
            <p class="text-2xl font-semibold text-ink">{searches.length}</p>
            <p class="text-xs text-muted">Búsquedas</p>
          </div>
          <div class="rounded-lg border border-rule bg-surface p-4">
            <p class="text-2xl font-semibold text-ink">{avgBudget !== null ? `$${avgBudget.toLocaleString()}` : "—"}</p>
            <p class="text-xs text-muted">Budget promedio</p>
          </div>
          <div class="rounded-lg border border-rule bg-surface p-4">
            <p class="text-2xl font-semibold text-ink">{shown.length}</p>
            <p class="text-xs text-muted">Recomendaciones mostradas</p>
          </div>
          <div class="rounded-lg border border-rule bg-surface p-4">
            <p class="text-2xl font-semibold text-ink">{roughCTR !== null ? `${roughCTR}%` : "—"}</p>
            <p class="text-xs text-muted">CTR agregado (no por búsqueda)</p>
          </div>
          <div class="rounded-lg border border-rule bg-surface p-4">
            <p class="text-2xl font-semibold text-ink">{netFavorites}</p>
            <p class="text-xs text-muted">
              Favoritos guardados{roughFavoriteRate !== null ? ` · ${roughFavoriteRate}% de lo mostrado` : ""}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-4">
          <div class="flex flex-col gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Top orígenes</h2>
            <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
              {topOrigins.length === 0 && <p class="p-3 text-sm text-muted">Sin datos.</p>}
              {topOrigins.map((o) => (
                <div class="flex items-center justify-between p-3 text-sm">
                  <span class="text-ink">{originLabel(o.key)}</span>
                  <span class="text-muted">{o.count}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Más mostrados</h2>
            <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
              {topShown.length === 0 && <p class="p-3 text-sm text-muted">Sin datos.</p>}
              {topShown.map((d) => (
                <div class="flex items-center justify-between p-3 text-sm">
                  <span class="text-ink">{destinationName(d.key)}</span>
                  <span class="text-muted">{d.count}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Más clickeados</h2>
            <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
              {topClicked.length === 0 && <p class="p-3 text-sm text-muted">Sin datos.</p>}
              {topClicked.map((d) => (
                <div class="flex items-center justify-between p-3 text-sm">
                  <span class="text-ink">{destinationName(d.key)}</span>
                  <span class="text-muted">{d.count}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Más guardados</h2>
            <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
              {topFavorited.length === 0 && <p class="p-3 text-sm text-muted">Sin datos.</p>}
              {topFavorited.map((d) => (
                <div class="flex items-center justify-between p-3 text-sm">
                  <span class="text-ink">{destinationName(d.key)}</span>
                  <span class="text-muted">{d.count}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-5">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Acceptance Rate</h2>
            <p class="text-xs text-muted">
              De las búsquedas donde se puede unir qué se mostró con qué se clickeó primero — {totalOutcomes} hasta ahora.
            </p>
          </div>

          {totalOutcomes === 0 ? (
            <p class="text-sm text-muted">
              Todavía no hay ninguna búsqueda completa (con clic) desde que se agregó el searchId — va a empezar a
              llenarse con uso real.
            </p>
          ) : (
            <>
              {totalOutcomes < MIN_OUTCOMES_FOR_CONFIDENCE && (
                <p class="rounded-md bg-highlight/10 px-3 py-2 text-xs text-highlight">
                  Todavía es poca muestra ({totalOutcomes}) — estos porcentajes van a moverse mucho hasta que haya al
                  menos {MIN_OUTCOMES_FOR_CONFIDENCE}.
                </p>
              )}

              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-bg p-3 text-center">
                  <p class="text-xl font-semibold text-ink">{rank1Pct}%</p>
                  <p class="text-xs text-muted">Eligió el #1</p>
                </div>
                <div class="rounded-md bg-bg p-3 text-center">
                  <p class="text-xl font-semibold text-ink">{rank2Pct}%</p>
                  <p class="text-xs text-muted">Eligió el #2</p>
                </div>
                <div class="rounded-md bg-bg p-3 text-center">
                  <p class="text-xl font-semibold text-ink">{rank3PlusPct}%</p>
                  <p class="text-xs text-muted">Eligió #3 o peor</p>
                </div>
              </div>

              <div class="rounded-md bg-bg p-3 text-sm">
                <p class="text-ink">
                  Cuando no eligió el #1, la diferencia de puntaje promedio con el #1 fue de{" "}
                  <span class="font-semibold">{avgScoreGap !== null ? avgScoreGap : "—"}</span> puntos.
                </p>
                <p class="mt-1 text-xs text-muted">
                  Diferencia chica (cerca de 0) = las opciones eran parecidas y eligió por gusto propio, señal sana.
                  Diferencia grande = puede que el scoring esté sobrevalorando algo que a la gente no le importa tanto.
                </p>
              </div>
            </>
          )}
        </div>

        <div class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-5">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">CTR por dimensión</h2>
            <p class="text-xs text-muted">
              Origen y presupuesto solo cubren eventos con searchId ({breakdownCoveragePct}% de la muestra) — el resto
              es de antes de que existiera ese campo.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Por rank</h3>
              <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-bg">
                {ctrByRank.map((r) => (
                  <div class="flex items-center justify-between p-2.5 text-sm">
                    <span class="text-ink">#{r.key}</span>
                    <span class="text-muted">{r.clicked}/{r.shown} shown</span>
                    <span class="font-medium text-ink">{r.ctr !== null ? `${r.ctr}%` : "—"}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Por destino</h3>
              <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-bg">
                {ctrByDestination.map((r) => (
                  <div class="flex items-center justify-between p-2.5 text-sm">
                    <span class="truncate text-ink">{destinationName(r.key as string)}</span>
                    <span class="shrink-0 text-muted">{r.clicked}/{r.shown}</span>
                    <span class="shrink-0 font-medium text-ink">{r.ctr !== null ? `${r.ctr}%` : "—"}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Por origen</h3>
              <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-bg">
                {ctrByOrigin.length === 0 && <p class="p-2.5 text-sm text-muted">Sin datos con searchId todavía.</p>}
                {ctrByOrigin.map((r) => (
                  <div class="flex items-center justify-between p-2.5 text-sm">
                    <span class="truncate text-ink">{originLabel(r.key as string)}</span>
                    <span class="shrink-0 text-muted">{r.clicked}/{r.shown}</span>
                    <span class="shrink-0 font-medium text-ink">{r.ctr !== null ? `${r.ctr}%` : "—"}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Por presupuesto</h3>
              <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-bg">
                {ctrByBudget.length === 0 && <p class="p-2.5 text-sm text-muted">Sin datos con searchId todavía.</p>}
                {ctrByBudget.map((r) => (
                  <div class="flex items-center justify-between p-2.5 text-sm">
                    <span class="truncate text-ink">{r.key}</span>
                    <span class="shrink-0 text-muted">{r.clicked}/{r.shown}</span>
                    <span class="shrink-0 font-medium text-ink">{r.ctr !== null ? `${r.ctr}%` : "—"}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-5">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Negocio — clicks por categoría</h2>
            <p class="text-xs text-muted">
              Todavía no hay forma de mostrar revenue real acá — el dashboard de Travelpayouts sigue en $0 de
              comisión, así que cualquier número de "revenue estimado" sería inventado. Esto es lo único que sí
              podemos afirmar con los datos que tenemos: cuántos clicks salieron a cada categoría de afiliado.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {clicksByCategory.map((c) => (
              <div class="rounded-md bg-bg p-3 text-center">
                <p class="text-xl font-semibold text-ink">{c.count}</p>
                <p class="text-xs text-muted">{c.key}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Actividad reciente</h2>
            <p class="text-xs text-muted">{totalEvents} eventos en total · página {page} de {totalPages}</p>
          </div>
          <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
            {pageEvents.map((e) => (
              <div class="flex items-center justify-between gap-4 p-3 text-sm">
                <span
                  class={`w-44 shrink-0 rounded-full px-2 py-0.5 text-center text-xs font-medium ${
                    e.name === "search_performed"
                      ? "bg-accent/10 text-accent"
                      : e.name === "recommendation_clicked"
                        ? "bg-highlight/10 text-highlight"
                        : e.name === "favorite_saved" || e.name === "favorite_removed"
                          ? "bg-green-600/10 text-green-700 dark:text-green-400"
                          : "bg-rule/60 text-muted"
                  }`}
                >
                  {e.name}
                </span>
                <span class="flex-1 truncate text-ink">{formatEvent(e)}</span>
                {e.isTest && (
                  <span class="shrink-0 rounded-full bg-red-600/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-red-600">
                    Test
                  </span>
                )}
                <span class="shrink-0 text-xs text-muted">{formatDate(e.createdAt)}</span>
              </div>
            ))}
          </div>

          {totalPages > 1 && (
            <nav class="flex flex-wrap items-center justify-center gap-1 pt-2" aria-label="Paginación de actividad">
              <a
                href={page > 1 ? `?page=${page - 1}` : undefined}
                aria-disabled={page <= 1}
                class={`rounded-md px-2.5 py-1.5 text-sm font-medium ${
                  page <= 1 ? "pointer-events-none text-muted opacity-40" : "text-ink hover:bg-surface-2"
                }`}
              >
                ←
              </a>
              {pageNumbers.map((n) => (
                <a
                  href={`?page=${n}`}
                  class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                    n === page ? "bg-accent text-accent-ink" : "text-ink hover:bg-surface-2"
                  }`}
                >
                  {n}
                </a>
              ))}
              <a
                href={page < totalPages ? `?page=${page + 1}` : undefined}
                aria-disabled={page >= totalPages}
                class={`rounded-md px-2.5 py-1.5 text-sm font-medium ${
                  page >= totalPages ? "pointer-events-none text-muted opacity-40" : "text-ink hover:bg-surface-2"
                }`}
              >
                →
              </a>
            </nav>
          )}
        </div>
      </>
    )}
  </div>
</AdminLayout>
