---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../lib/requireAdminSession";
import { destinations } from "@aritrips/data";
import { getHomeLayoutConfig, DEFAULT_SECTION_ORDER, type HomeSectionId } from "../../lib/homeLayoutConfig";

export const prerender = false;

// Sin esto, volver acá con "atrás" del navegador podría mostrar valores
// viejos de bfcache en vez de lo último guardado — mismo bug ya arreglado
// en /ari-admin/images (2026-08-10).
Astro.response.headers.set("Cache-Control", "no-store");

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;
const credentials =
  FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY
    ? { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") }
    : null;
const config = await getHomeLayoutConfig(credentials);

const destinationOptions = destinations.map((d) => ({ id: d.id, name: d.name, country: d.country })).sort((a, b) => a.name.localeCompare(b.name));

const SECTION_LABELS: Record<HomeSectionId, string> = {
  demo: "✈️ What can Ari find for you?",
  "how-it-works": "How Ari works",
  blog: "From the blog",
  "trip-ideas": "Trip ideas by city",
};
---

<AdminLayout title="Home Layout — AriTrips Admin" session={session} active="pages">
  <div class="flex max-w-2xl flex-col gap-8">
    <div>
      <a href="/ari-admin/pages" class="text-sm text-muted hover:text-accent">← Pages</a>
      <h1 class="text-2xl font-semibold text-ink">Home layout</h1>
      <p class="text-sm text-muted">
        Reordená las secciones y editá el destino de ejemplo — guardás y se aplica directo en la Home real, sin
        deploy. Hero+CTA siempre queda primero y el footer siempre último. El tamaño/espaciado de la card de ejemplo
        ya no es editable acá — quedó fijo en el código.
      </p>
    </div>

    <!-- Orden de secciones — a pedido del usuario (2026-08-10): "un
         editor... que pueda mover de posición las secciones". Botones
         arriba/abajo en vez de drag-and-drop real: mucho más simple de
         hacer bien y accesible por teclado, mismo resultado final. -->
    <div class="flex flex-col gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Section order</h2>
      <ol id="section-order-list" class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
        {
          config.sectionOrder.map((id, i) => (
            <li data-section-id={id} class="flex items-center justify-between gap-3 p-3">
              <span class="text-sm text-ink">
                <span class="mr-2 font-mono text-xs text-muted" data-position>
                  {i + 1}
                </span>
                {SECTION_LABELS[id]}
              </span>
              <span class="flex gap-1">
                <button
                  type="button"
                  data-move="up"
                  class="rounded-md border border-rule px-2 py-1 text-xs text-ink hover:border-accent hover:text-accent disabled:opacity-30"
                >
                  ↑
                </button>
                <button
                  type="button"
                  data-move="down"
                  class="rounded-md border border-rule px-2 py-1 text-xs text-ink hover:border-accent hover:text-accent disabled:opacity-30"
                >
                  ↓
                </button>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Contenido de la card de ejemplo (2026-08-19, reemplaza los
         sliders de tamaño que el usuario pidió sacar: "no la necesito de
         verdad... lo que sí me podría servir es poder cambiar el texto de
         la oferta y la imagen del destino"). El destino elegido maneja
         tanto el nombre como la foto (misma lógica que ya usa index.astro:
         foto aprobada a mano en /ari-admin/images si existe, si no
         búsqueda por el imageQuery curado del destino). -->
    <div class="flex flex-col gap-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">"What can Ari find for you?" example trip</h2>
      <div class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-4">
        <div class="grid grid-cols-2 gap-3">
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Destination</span>
            <select id="demo-destination" class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink">
              {destinationOptions.map((d) => (
                <option value={d.id} selected={d.id === config.demoTrip.destinationId}>
                  {d.name} ({d.country})
                </option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Flag emoji</span>
            <input id="demo-flag" type="text" maxlength={8} value={config.demoTrip.flag} class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
          </label>
          <label class="col-span-2 flex flex-col gap-1 text-sm">
            <span class="text-ink">Budget label</span>
            <input
              id="demo-budget-label"
              type="text"
              maxlength={40}
              value={config.demoTrip.budgetLabel}
              placeholder="$700 budget"
              class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Total $</span>
            <input id="demo-total" type="number" min="0" value={config.demoTrip.total} class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Flight $</span>
            <input id="demo-flight" type="number" min="0" value={config.demoTrip.flight} class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Hotel $</span>
            <input id="demo-hotel" type="number" min="0" value={config.demoTrip.hotel} class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink" />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-ink">Activities $</span>
            <input
              id="demo-activities"
              type="number"
              min="0"
              value={config.demoTrip.activities}
              class="rounded-md border border-rule bg-bg px-2 py-1.5 text-sm text-ink"
            />
          </label>
        </div>
        <p class="text-xs text-muted">
          La foto sale de la que ya esté aprobada para ese destino en <a href="/ari-admin/images" class="underline hover:text-accent">Images</a>, o si no hay
          ninguna, de una búsqueda automática — no hay un campo de imagen aparte acá.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button type="button" data-save class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:opacity-90"> Save </button>
      <p data-status class="text-xs text-muted"></p>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ defaultOrder: DEFAULT_SECTION_ORDER }}>
  // Lista de orden — botones arriba/abajo mueven el <li> en el DOM y
  // renumeran las posiciones; el orden final se lee directo del DOM al
  // guardar, no de un array en memoria aparte, para que no puedan desincronizarse.
  const orderList = document.getElementById("section-order-list");

  function renumber() {
    const items = [...orderList.children];
    items.forEach((li, i) => {
      const posEl = li.querySelector("[data-position]");
      if (posEl) posEl.textContent = String(i + 1);
      li.querySelector('[data-move="up"]').disabled = i === 0;
      li.querySelector('[data-move="down"]').disabled = i === items.length - 1;
    });
  }

  orderList?.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-move]");
    if (!btn) return;
    const li = btn.closest("li");
    if (btn.dataset.move === "up" && li.previousElementSibling) {
      li.parentElement.insertBefore(li, li.previousElementSibling);
    } else if (btn.dataset.move === "down" && li.nextElementSibling) {
      li.parentElement.insertBefore(li.nextElementSibling, li);
    }
    renumber();
  });

  renumber();

  document.querySelector("[data-save]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const statusEl = document.querySelector("[data-status]");
    const payload = {
      sectionOrder: [...orderList.children].map((li) => li.dataset.sectionId),
      destinationId: document.getElementById("demo-destination").value,
      flag: document.getElementById("demo-flag").value,
      budgetLabel: document.getElementById("demo-budget-label").value,
      total: Number(document.getElementById("demo-total").value),
      flight: Number(document.getElementById("demo-flight").value),
      hotel: Number(document.getElementById("demo-hotel").value),
      activities: Number(document.getElementById("demo-activities").value),
    };
    btn.disabled = true;
    if (statusEl) statusEl.textContent = "Saving…";
    try {
      const res = await fetch("/api/admin/home-layout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (statusEl) statusEl.textContent = res.ok ? "Saved — live on the Home page now." : "Couldn't save — try again.";
    } catch {
      if (statusEl) statusEl.textContent = "Couldn't save — try again.";
    } finally {
      btn.disabled = false;
    }
  });
</script>
