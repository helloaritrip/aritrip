---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../lib/requireAdminSession";
import {
  SCORING_WEIGHTS_V1,
  ADVANCE_PURCHASE_FACTORS,
  COST_TIER_MULTIPLIER,
  MAX_TOTAL_MULTIPLIER,
  MIN_TOTAL_MULTIPLIER,
  MIN_REASONABLE_ROUND_TRIP_USD,
} from "@aritrips/data";

export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

// Página de solo lectura (2026-08-10) — estas reglas viven como
// constantes en packages/data, no en Firestore. Se muestran acá para
// tener visibilidad de qué está activo sin tener que ir a leer código,
// pero cambiarlas todavía requiere un deploy — hacerlas editables desde
// acá es una decisión aparte (implica que el motor las lea de Firestore
// en cada búsqueda, con su propio costo/caché a pensar).
const weightRows = Object.entries(SCORING_WEIGHTS_V1.weights).sort((a, b) => b[1] - a[1]);

function formatDayRange(minDays: number, maxDays: number): string {
  if (maxDays === Infinity) return `${minDays}+ días`;
  if (minDays === maxDays) return `${minDays} días`;
  return `${minDays}-${maxDays} días`;
}
---

<AdminLayout title="Travel Rules — AriTrips Admin" session={session} active="travel-rules">
  <div class="flex max-w-3xl flex-col gap-8">
    <div>
      <h1 class="text-2xl font-semibold text-ink">Travel Rules</h1>
      <p class="text-sm text-muted">
        Las reglas que usa Ari hoy para puntuar destinos y estimar precios. Todavía es de solo lectura — viven como
        código en <code class="rounded bg-surface-2 px-1 py-0.5 text-xs">packages/data</code>, cambiarlas requiere un
        deploy.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Pesos del scoring ({SCORING_WEIGHTS_V1.version})</h2>
        <p class="text-xs text-muted">Cuánto pesa cada factor al ordenar los destinos recomendados. Suman 100%.</p>
      </div>
      <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
        {weightRows.map(([key, value]) => (
          <div class="flex items-center gap-3 p-3">
            <span class="w-40 shrink-0 text-sm text-ink">{key}</span>
            <div class="h-2 flex-1 overflow-hidden rounded-full bg-rule">
              <div class="h-full rounded-full bg-accent" style={`width: ${value * 100}%`} />
            </div>
            <span class="w-12 shrink-0 text-right text-sm font-medium text-ink">{Math.round(value * 100)}%</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-muted">
        Además, una búsqueda descarta cualquier destino que use más del 105% del presupuesto — no compite ni por
        puntaje, se saca antes.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Anticipación de compra</h2>
        <p class="text-xs text-muted">
          Cuánto se ajusta el precio de vuelo estimado según qué tan cerca está la fecha de salida (agregado 2026-08-10).
        </p>
      </div>
      <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
        {ADVANCE_PURCHASE_FACTORS.map((bucket) => (
          <div class="flex items-center justify-between p-3 text-sm">
            <span class="text-ink">{formatDayRange(bucket.minDays, bucket.maxDays)}</span>
            <span class={`font-medium ${bucket.factor === 1 ? "text-muted" : bucket.factor > 1 ? "text-highlight" : "text-accent"}`}>
              {bucket.factor.toFixed(2)}x
            </span>
          </div>
        ))}
      </div>
      <p class="text-xs text-muted">
        Techo y piso de seguridad: el ajuste nunca multiplica más de {MAX_TOTAL_MULTIPLIER.toFixed(2)}x ni menos de{" "}
        {MIN_TOTAL_MULTIPLIER.toFixed(2)}x el precio base, y ningún vuelo ida y vuelta se muestra por debajo de $
        {MIN_REASONABLE_ROUND_TRIP_USD}.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Temporada (por destino)</h2>
        <p class="text-xs text-muted">
          Cada destino tiene su propia temporada alta/media/baja curada — esto es el multiplicador que se le aplica al
          precio base según en cuál caiga la fecha de viaje.
        </p>
      </div>
      <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
        {Object.entries(COST_TIER_MULTIPLIER).map(([tier, value]) => (
          <div class="flex items-center justify-between p-3 text-sm">
            <span class="capitalize text-ink">{tier}</span>
            <span class="font-medium text-ink">{value.toFixed(2)}x</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
