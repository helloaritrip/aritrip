---
import { env } from "cloudflare:workers";
import { PuckEditor } from "../../puck/PuckEditor";
import { getAdminSession } from "../../lib/requireAdminSession";

// SSR solo en esta página (el resto del sitio sigue siendo estático) para
// poder chequear la sesión en cada request — un editor de contenido
// público sin login era un hueco de seguridad real una vez deployado.
// Reemplaza el Basic Auth de una sola contraseña compartida (2026-08-07)
// por sesiones reales por administrador — ver /ari-admin/users.
export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content editor (internal)</title>
  </head>
  <body>
    <PuckEditor client:only="react" />
  </body>
</html>
