---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAdminSession } from "../../../lib/requireAdminSession";
import { listDocuments, destinations } from "@aritrips/data";
import { getAdRailsEnabled } from "../../../lib/adConfig";

// Deliberadamente SIN cache acá (2026-08-14) — a diferencia de /deals,
// /blog, etc. (ver dealsCache.ts/pagesCache.ts), esta es la pantalla
// donde el dueño crea/republica páginas y espera ver el resultado al
// toque; la colección `pages` además es chica (decenas de docs, no
// cientos), así que el ahorro de lecturas acá no vale el riesgo de
// confusión ("¿por qué no aparece la página que acabo de crear?").

export const prerender = false;

const session = await getAdminSession(Astro.cookies, env);
if (!session) {
  return Astro.redirect(`/ari-admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;
type PageDoc = { id: string; title?: unknown; status?: unknown; template?: unknown; updatedAt?: unknown };
let pages: PageDoc[] = [];
let loadError: string | null = null;
let adRailsEnabled = true;

if (FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY) {
  const credentials = { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") };
  try {
    pages = await listDocuments("pages", credentials);
    pages.sort((a, b) => String(b.updatedAt ?? "").localeCompare(String(a.updatedAt ?? "")));
  } catch (err) {
    loadError = err instanceof Error ? err.message : "Failed to load pages.";
  }
  adRailsEnabled = await getAdRailsEnabled(credentials);
} else {
  loadError = "Firestore isn't configured yet (missing secrets).";
}

// Categorización para los filtros de abajo — el campo `template` guardado
// en Firestore solo distingue "hub"/"blog"/"custom" (migrate-to-firestore.ts),
// no alcanza para separar las 40 páginas de destino individual del resto de
// "custom" (about, comparativas). El slug + el catálogo real de destinos
// (packages/data) son más confiables que confiar solo en ese campo.
const destinationIds = new Set(destinations.map((d) => d.id));
type PageCategory = "hub" | "destino" | "blog" | "otras";
function categoryOf(p: PageDoc): PageCategory {
  if (p.id.startsWith("best-trips-from-")) return "hub";
  if (p.template === "blog") return "blog";
  if (destinationIds.has(p.id)) return "destino";
  return "otras";
}
const CATEGORY_LABELS: Record<"todas" | PageCategory, string> = {
  todas: "Todas",
  hub: "Hubs",
  destino: "Destinos",
  blog: "Blog",
  otras: "Otras",
};
const categoryCounts: Record<"todas" | PageCategory, number> = { todas: pages.length, hub: 0, destino: 0, blog: 0, otras: 0 };
for (const p of pages) categoryCounts[categoryOf(p)] += 1;
---

<AdminLayout title="Pages — AriTrips Admin" session={session} active="pages">
  <div class="flex max-w-3xl flex-col gap-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-ink">Pages</h1>
        <p class="text-sm text-muted">Built with the Puck templates — {pages.length} page{pages.length === 1 ? "" : "s"}.</p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button
          type="button"
          id="republish-destination-pages-btn"
          class="rounded-md border border-rule px-3 py-1.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          🖼️ Republish destination pages
        </button>
        <button
          type="button"
          id="republish-hub-pages-btn"
          class="rounded-md border border-rule px-3 py-1.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          🔄 Republish hub pages
        </button>
        <a
          href="/ari-admin/home-layout"
          class="rounded-md border border-rule px-3 py-1.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          🎨 Edit Home layout
        </a>
      </div>
    </div>

    <p id="republish-destination-status" class="text-xs text-muted"></p>
    <p id="republish-status" class="text-xs text-muted"></p>

    {loadError && <p class="rounded-md border border-rule bg-surface p-4 text-sm text-red-600 dark:text-red-400">{loadError}</p>}

    <div class="flex items-center justify-between gap-4 rounded-lg border border-rule bg-surface p-4">
      <div>
        <p class="text-sm font-medium text-ink">Ad space rails</p>
        <p class="text-xs text-muted">
          Columnas de 160×600 reservadas a los costados de cada página de contenido. Apagalas mientras dure la revisión
          de AdSense u otro momento en que no quieras mostrarlas — no requiere deploy.
        </p>
      </div>
      <label class="relative inline-flex shrink-0 cursor-pointer items-center">
        <input type="checkbox" id="ad-rails-toggle" class="peer sr-only" checked={adRailsEnabled} />
        <div class="h-6 w-11 rounded-full bg-rule transition-colors peer-checked:bg-accent" />
        <div class="absolute left-1 h-4 w-4 rounded-full bg-white transition-transform peer-checked:translate-x-5" />
      </label>
    </div>
    <p id="ad-rails-status" class="-mt-4 text-xs text-muted"></p>

    <form id="new-page-form" class="flex items-end gap-3 rounded-lg border border-rule bg-surface p-4">
      <label class="flex flex-1 flex-col gap-1.5 text-sm">
        <span class="font-medium text-ink">New page slug</span>
        <input
          type="text"
          name="slug"
          placeholder="e.g. best-trips-from-miami"
          pattern="[a-z0-9-]+"
          required
          class="rounded-md border border-rule bg-surface px-3 py-2 text-ink focus:outline focus:outline-2 focus:outline-accent"
        />
      </label>
      <button type="submit" class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:opacity-90">
        Create
      </button>
    </form>

    <div class="flex flex-wrap gap-2">
      {
        (Object.keys(CATEGORY_LABELS) as (keyof typeof CATEGORY_LABELS)[]).map((key) => (
          <button
            type="button"
            class="page-filter-btn rounded-full border border-rule px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent"
            data-filter={key}
            aria-pressed={key === "todas" ? "true" : "false"}
          >
            {CATEGORY_LABELS[key]} ({categoryCounts[key]})
          </button>
        ))
      }
    </div>

    <div class="flex flex-col divide-y divide-rule rounded-lg border border-rule bg-surface">
      {
        pages.map((p) => (
          <a
            href={`/ari-admin/edit?slug=${encodeURIComponent(p.id)}`}
            data-category={categoryOf(p)}
            class="page-row flex items-center justify-between gap-3 p-4 hover:bg-bg"
          >
            <div>
              <p class="text-sm font-medium text-ink">{String(p.title ?? p.id)}</p>
              <p class="text-xs text-muted">/p/{p.id}</p>
            </div>
            <span
              class={`rounded-full px-2.5 py-1 text-xs font-medium ${
                p.status === "published" ? "bg-accent/10 text-accent" : "bg-highlight/10 text-highlight"
              }`}
            >
              {String(p.status ?? "draft")}
            </span>
          </a>
        ))
      }
      {pages.length === 0 && !loadError && <p class="p-4 text-sm text-muted">No pages yet — create one above.</p>}
      <p id="filter-empty-msg" class="hidden p-4 text-sm text-muted">No pages in this category.</p>
    </div>
  </div>
</AdminLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".page-filter-btn");
  const pageRows = document.querySelectorAll<HTMLAnchorElement>(".page-row");
  const emptyMsg = document.getElementById("filter-empty-msg")!;

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      const filter = btn.dataset.filter;
      let visibleCount = 0;
      pageRows.forEach((row) => {
        const match = filter === "todas" || row.dataset.category === filter;
        row.classList.toggle("hidden", !match);
        if (match) visibleCount += 1;
      });
      emptyMsg.classList.toggle("hidden", visibleCount !== 0);
    });
  });

  document.getElementById("republish-destination-pages-btn")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const statusEl = document.getElementById("republish-destination-status")!;
    btn.disabled = true;
    statusEl.textContent = "Republicando las 48 páginas de destino...";
    try {
      const res = await fetch("/api/admin/republish-destination-pages", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as {
        results?: { slug: string; status: string }[];
        error?: string;
      };
      if (res.ok && data.results) {
        const created = data.results.filter((r) => r.status === "created").length;
        const updated = data.results.filter((r) => r.status === "updated").length;
        const problems = data.results.filter((r) => r.status !== "created" && r.status !== "updated");
        statusEl.textContent =
          problems.length === 0
            ? `Listo — ${created} creadas, ${updated} actualizadas ✓`
            : `${created} creadas, ${updated} actualizadas. Con problemas: ${problems.map((p) => `${p.slug} (${p.status})`).join(", ")}`;
      } else {
        statusEl.textContent = data.error || "No se pudo republicar.";
      }
    } catch {
      statusEl.textContent = "No se pudo republicar (error de red).";
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById("republish-hub-pages-btn")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const statusEl = document.getElementById("republish-status")!;
    btn.disabled = true;
    statusEl.textContent = "Regenerando las 24 páginas de ciudad...";
    try {
      const res = await fetch("/api/admin/republish-hub-pages", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as {
        results?: { slug: string; status: string }[];
        error?: string;
      };
      if (res.ok && data.results) {
        const updated = data.results.filter((r) => r.status === "updated").length;
        const problems = data.results.filter((r) => r.status !== "updated");
        statusEl.textContent =
          problems.length === 0
            ? `Listo — ${updated}/24 páginas republicadas ✓`
            : `${updated}/24 republicadas. Con problemas: ${problems.map((p) => `${p.slug} (${p.status})`).join(", ")}`;
      } else {
        statusEl.textContent = data.error || "No se pudo republicar.";
      }
    } catch {
      statusEl.textContent = "No se pudo republicar (error de red).";
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById("ad-rails-toggle")?.addEventListener("change", async (e) => {
    const checkbox = e.target as HTMLInputElement;
    const statusEl = document.getElementById("ad-rails-status")!;
    statusEl.textContent = "Guardando...";
    const res = await fetch("/api/admin/ad-rails", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ enabled: checkbox.checked }),
    });
    if (res.ok) {
      statusEl.textContent = checkbox.checked ? "Anuncios reservados: visibles ✓" : "Anuncios reservados: ocultos ✓";
      setTimeout(() => (statusEl.textContent = ""), 2500);
    } else {
      checkbox.checked = !checkbox.checked;
      statusEl.textContent = "No se pudo guardar, intentá de nuevo.";
    }
  });

  document.getElementById("new-page-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const slug = new FormData(form).get("slug");
    if (typeof slug === "string" && slug) {
      window.location.href = `/ari-admin/edit?slug=${encodeURIComponent(slug)}`;
    }
  });
</script>
