---
// Redirect — la página vivía en /ofertas antes de que el usuario pidiera
// renombrarla a /deals (2026-08-13, sitio en inglés). Se deja este
// redirect 301 por si algo externo (Google, un link compartido) ya
// apuntaba a la URL vieja en los minutos que estuvo publicada.
export const prerender = false;
return Astro.redirect("/deals", 301);
---
