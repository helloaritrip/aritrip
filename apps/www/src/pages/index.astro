---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { Button } from "@aritrips/ui";
import { ORIGIN_HUBS, ORIGIN_LABELS } from "@aritrips/data";
import { getCachedPageIndex } from "../lib/pagesCache";
import { getCachedDestinationImageUrl } from "../lib/destinationImageCache";
import { cityName, hubPageSlug } from "../lib/citySlug";
import { getHomeLayoutConfig, HOME_SECTION_IDS, DEFAULT_SECTION_ORDER, type HomeSectionId } from "../lib/homeLayoutConfig";

// SSR solo para poder leer los últimos posts del blog en cada visita — el
// resto de la home sigue siendo estático (mismo patrón ya usado en /blog
// y /p/[slug]).
export const prerender = false;

// Cache de borde en Cloudflare (2026-08-14) — es la página con más
// tráfico del sitio; sin esto, cada visita anónima le pegaba a Firestore
// dos veces (pages + siteConfig/home). Ver dealsCache.ts para el
// contexto completo (cuota diaria gratis agotada una vez por esto mismo).
// s-maxage subido de 300 a 900 (2026-08-15, auditoría de lecturas) —
// mismo motivo que /blog: contenido editado a mano, no en vivo.
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=1800");

const APP_URL_FOR_IMAGES = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
function imageProxyUrl(query: string, fallback: string): string {
  return `${APP_URL_FOR_IMAGES}/api/image-proxy?q=${encodeURIComponent(query)}&fallback=${encodeURIComponent(fallback)}`;
}

type BlogDoc = { id: string; title?: unknown; description?: unknown; featuredImageQuery?: unknown; publishedAt?: unknown };
let latestPosts: BlogDoc[] = [];
const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;
const credentials =
  FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY
    ? { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") }
    : null;
if (credentials) {
  try {
    const entries = await getCachedPageIndex(credentials);
    latestPosts = (entries.filter((e) => e.template === "blog" && e.status === "published") as BlogDoc[])
      .sort((a, b) => String(b.publishedAt ?? "").localeCompare(String(a.publishedAt ?? "")))
      .slice(0, 3);
  } catch {
    latestPosts = [];
  }
}

// Editable a mano desde /ari-admin/home-layout (2026-08-10) — ver
// lib/homeLayoutConfig.ts para por qué esto existe (varias rondas de
// ida y vuelta por captura de pantalla que no convergían rápido).
const homeLayout = await getHomeLayoutConfig(credentials);

// Links a las 24 páginas "Best trips from {city}" (generate-hub-pages.ts)
// — sin esto quedan huérfanas: ni Google ni un usuario real las encuentra.
const cityLinks = ORIGIN_HUBS.map((hub) => ({
  city: cityName(ORIGIN_LABELS[hub]),
  href: `/p/${hubPageSlug(ORIGIN_LABELS[hub])}`,
})).sort((a, b) => a.city.localeCompare(b.city));

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "AriTrips",
    url: "https://aritrips.com",
    logo: "https://aritrips.com/favicon.webp",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "AriTrips",
    url: "https://aritrips.com",
    potentialAction: {
      "@type": "SearchAction",
      target: "https://aritrips.com/blog?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  },
];

// Ari es un activo de marca, no solo un logo (2026-08-10, a pedido del
// usuario) — este bloque pasa de "Step 1/2/3" genérico a hablar de Ari
// directamente. Los íconos son recortes reales de la hoja de marca (Ari,
// la maleta) que compartió el usuario — no emoji. Nota: el gato 🐱 que
// había acá antes NO era un error de branding (Ari es literalmente su
// gata, de ahí el nombre del proyecto) pero sí era el ícono equivocado
// para "presupuesto" — la alcancía de la hoja de marca es mucho más clara.
const steps = [
  { icon: "/ari/icon-piggybank.png", title: "1. Give Ari your budget", body: "Tell Ari how much you want to spend." },
  { icon: "/ari/icon-search.png", title: "2. Ari finds your trip", body: "Flights + hotels + activities that fit." },
  { icon: "/ari/icon-map.png", title: "3. Book what you like", body: "Ari sends you directly to the provider." },
];

// Demo estático a propósito (2026-08-10) — el objetivo es que el visitante
// entienda qué hace Ari en 3 segundos mirando la Home, no una búsqueda en
// vivo. Números ilustrativos, coherentes con el resto del catálogo curado.
// Un solo ejemplo, no dos (2026-08-10, a pedido del usuario tras ver la
// versión de 3 columnas muy apretada) — Cancún, con la misma query que usa
// el catálogo real (packages/data), en una card más ancha con más aire.
const demoTrip = {
  budgetLabel: "$700 budget",
  flag: "🇲🇽",
  destination: "Cancún",
  total: 642,
  flight: 280,
  hotel: 210,
  activities: 152,
  imageQuery: "cancun turquoise beach aerial",
};

// Bug real reportado por el usuario (2026-08-10): esta card seguía
// mostrando la foto vieja (búsqueda en vivo por texto) en vez de la que ya
// se había aprobado a mano para Cancún desde /ari-admin/images — nunca se
// conectó con destinationImages, a diferencia de las cards de apps/app
// (ResultCard/DiscoverSection), que sí la usan. Mismo patrón acá: si hay
// foto fijada, gana sobre la búsqueda por query.
let demoImageUrl: string | undefined;
if (credentials) {
  demoImageUrl = await getCachedDestinationImageUrl("cancun", credentials);
}
---

<Layout
  title="AriTrips — Find the best trip you can take on your budget"
  description="Tell us your budget and we'll show you which destinations actually fit — real flight, hotel, and activity costs, not just a flight price."
  jsonLd={homeJsonLd}
>
  <main class="mx-auto flex max-w-5xl flex-col gap-24 px-6 py-20">
    <!-- 1. Hero, 2. Budget CTA — centrado, sin la mascota (movida a la fila
         de ejemplos de abajo, 2026-08-10 a pedido del usuario). -->
    <section class="flex flex-col items-center gap-6 text-center">
      <h1 class="max-w-2xl text-4xl font-semibold text-balance text-ink sm:text-5xl">
        Find the best trip you can take on your budget.
      </h1>
      <p class="max-w-xl text-lg text-muted">
        Tell us how much you want to spend. Ari finds destinations where your flight, hotel and
        activities actually fit.
      </p>
      <Button href={APP_URL} className="px-6 py-3 text-base">
        Find my trip →
      </Button>
    </section>

    <!-- 3-6. Estas 4 secciones se pueden reordenar a mano desde
         /ari-admin/home-layout (2026-08-10, a pedido del usuario: "un
         editor... que pueda mover de posición las secciones") — orden real
         en homeLayout.sectionOrder, con Hero+CTA fijo primero y footer fijo
         al final (ver homeLayoutConfig.ts para por qué). -->
    {
      homeLayout.sectionOrder.map((id: HomeSectionId) => {
        if (id === "demo") {
          return (
            <section class="flex flex-col items-center gap-4">
              <h2 class="text-xl font-semibold text-ink">✈️ What can Ari find for you?</h2>
              <div class="demo-row">
                <img
                  src="/ari/mascot.png"
                  alt="Ari, the AriTrips suitcase mascot"
                  width="180"
                  height="270"
                  class="demo-mascot w-auto object-contain"
                />
                <div class="demo-card flex overflow-hidden rounded-lg border border-rule bg-surface">
                  <img
                    src={demoImageUrl || imageProxyUrl(demoTrip.imageQuery, demoTrip.destination)}
                    alt={demoTrip.destination}
                    width={homeLayout.photoWidth}
                    height={homeLayout.photoHeight}
                    class="demo-photo shrink-0 object-cover"
                    loading="lazy"
                  />
                  <div class="demo-text flex flex-col justify-center gap-1.5">
                    <p class="text-xs font-medium uppercase tracking-wide text-muted">{demoTrip.budgetLabel}</p>
                    <p class="text-xl font-semibold text-ink">
                      {demoTrip.flag} {demoTrip.destination} — ${demoTrip.total}
                    </p>
                    <div class="flex flex-col gap-1 text-sm text-muted">
                      <p>✈️ Flight ${demoTrip.flight}</p>
                      <p>🏨 Hotel ${demoTrip.hotel}</p>
                      <p>🎟️ Activities ${demoTrip.activities}</p>
                    </div>
                  </div>
                </div>
              </div>
              <p class="text-xs text-muted">
                Estimates · No booking fees · Compare real travel options · Book directly with trusted providers
              </p>
            </section>
          );
        }
        if (id === "how-it-works") {
          return (
            <section class="flex flex-col gap-6">
              <h2 class="text-center text-2xl font-semibold text-ink">How Ari works</h2>
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                {steps.map((step) => (
                  <div class="flex flex-col items-center gap-2 rounded-lg border border-rule bg-surface p-6 text-center">
                    <img src={step.icon} alt="" width="72" height="72" class="h-16 w-16" />
                    <h3 class="text-lg font-semibold text-ink">{step.title}</h3>
                    <p class="text-sm text-muted">{step.body}</p>
                  </div>
                ))}
              </div>
            </section>
          );
        }
        if (id === "blog") {
          return (
            <section class="flex flex-col gap-6">
              <div class="flex items-center justify-between">
                <h2 class="text-2xl font-semibold text-ink">From the blog</h2>
                <a href="/blog" class="text-sm font-medium text-accent hover:underline">
                  See all posts →
                </a>
              </div>
              {latestPosts.length === 0 ? (
                <p class="text-sm text-muted">New posts are on their way — check back soon.</p>
              ) : (
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                  {latestPosts.map((post) => (
                    <a
                      href={`/p/${post.id}`}
                      class="flex flex-col gap-3 overflow-hidden rounded-lg border border-rule bg-surface transition-shadow hover:shadow-md"
                    >
                      <img
                        src={imageProxyUrl(String(post.featuredImageQuery || post.title || post.id), String(post.title ?? post.id))}
                        alt={String(post.title ?? "")}
                        width="400"
                        height="225"
                        class="h-40 w-full object-cover"
                        loading="lazy"
                      />
                      <div class="flex flex-col gap-1 px-4 pb-4">
                        <h3 class="text-base font-semibold text-ink">{String(post.title ?? post.id)}</h3>
                        {post.description ? <p class="text-sm text-muted">{String(post.description)}</p> : null}
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </section>
          );
        }
        // id === "trip-ideas"
        return (
          <section class="flex flex-col gap-6">
            <h2 class="text-center text-2xl font-semibold text-ink">Trip ideas by city</h2>
            <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm">
              {cityLinks.map((link) => (
                <a href={link.href} class="text-muted hover:text-accent">
                  Best trips from {link.city}
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </main>
</Layout>

<style define:vars={{
  mascotH: `${homeLayout.mascotHeight}px`,
  rowGap: `${homeLayout.rowGap}px`,
  cardPadLeft: `${homeLayout.cardPadLeft}px`,
  photoW: `${homeLayout.photoWidth}px`,
  photoH: `${homeLayout.photoHeight}px`,
  textPad: `${homeLayout.cardTextPad}px`,
}}>
  /* Mobile primero: valores fijos y compactos, sin importar lo que se haya
     ajustado en el editor para desktop (2026-08-10, bug real reportado por
     el usuario: en mobile los valores grandes de desktop, aplicados como
     inline style sin diferenciar breakpoint, desbordaban la pantalla y
     rompían el layout). A partir de 640px se usan los valores reales del
     editor, vía las custom properties de arriba. */
  .demo-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
  }
  .demo-mascot {
    height: 160px;
  }
  .demo-card {
    flex-direction: column;
    width: 100%;
    max-width: 320px;
  }
  .demo-photo {
    width: 100%;
    height: 180px;
  }
  .demo-text {
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .demo-row {
      flex-direction: row;
      gap: var(--rowGap);
      width: auto;
    }
    .demo-mascot {
      height: var(--mascotH);
    }
    .demo-card {
      flex-direction: row;
      width: auto;
      max-width: none;
      padding-left: var(--cardPadLeft);
    }
    .demo-photo {
      width: var(--photoW);
      height: var(--photoH);
    }
    .demo-text {
      padding: var(--textPad);
    }
  }
</style>
