---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { Button } from "@aritrips/ui";
import { ORIGIN_HUBS, ORIGIN_LABELS, listDocuments } from "@aritrips/data";
import { cityName, hubPageSlug } from "../lib/citySlug";

// SSR solo para poder leer los últimos posts del blog en cada visita — el
// resto de la home sigue siendo estático (mismo patrón ya usado en /blog
// y /p/[slug]).
export const prerender = false;

const APP_URL_FOR_IMAGES = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
function imageProxyUrl(query: string, fallback: string): string {
  return `${APP_URL_FOR_IMAGES}/api/image-proxy?q=${encodeURIComponent(query)}&fallback=${encodeURIComponent(fallback)}`;
}

type BlogDoc = { id: string; title?: unknown; description?: unknown; featuredImageQuery?: unknown; publishedAt?: unknown };
let latestPosts: BlogDoc[] = [];
const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;
if (FIREBASE_CLIENT_EMAIL && FIREBASE_PRIVATE_KEY) {
  try {
    const credentials = { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") };
    const docs = await listDocuments("pages", credentials);
    latestPosts = (docs.filter((d) => d.template === "blog" && d.status === "published") as BlogDoc[])
      .sort((a, b) => String(b.publishedAt ?? "").localeCompare(String(a.publishedAt ?? "")))
      .slice(0, 3);
  } catch {
    latestPosts = [];
  }
}

// Links a las 24 páginas "Best trips from {city}" (generate-hub-pages.ts)
// — sin esto quedan huérfanas: ni Google ni un usuario real las encuentra.
const cityLinks = ORIGIN_HUBS.map((hub) => ({
  city: cityName(ORIGIN_LABELS[hub]),
  href: `/p/${hubPageSlug(ORIGIN_LABELS[hub])}`,
})).sort((a, b) => a.city.localeCompare(b.city));

const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "AriTrips",
    url: "https://aritrips.com",
    logo: "https://aritrips.com/favicon.svg",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "AriTrips",
    url: "https://aritrips.com",
    potentialAction: {
      "@type": "SearchAction",
      target: "https://aritrips.com/blog?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  },
];

// Ari es un activo de marca, no solo un logo (2026-08-10, a pedido del
// usuario) — este bloque pasa de "Step 1/2/3" genérico a hablar de Ari
// directamente, con su propio emoji por paso en vez de una etiqueta
// uppercase de SaaS.
const steps = [
  { emoji: "🐱", title: "1. Give Ari your budget", body: "Tell Ari how much you want to spend." },
  { emoji: "✈️", title: "2. Ari finds your trip", body: "Flights + hotels + activities that fit." },
  { emoji: "🎒", title: "3. Book what you like", body: "Ari sends you directly to the provider." },
];

// Demo estático a propósito (2026-08-10) — el objetivo es que el visitante
// entienda qué hace Ari en 3 segundos mirando la Home, no una búsqueda en
// vivo. Números ilustrativos, coherentes con el resto del catálogo curado.
const demoTrips = [
  { budgetLabel: "$700 budget", flag: "🇲🇽", destination: "Mexico City", total: 642, flight: 280, hotel: 210, activities: 152 },
  { budgetLabel: "$850 budget", flag: "🇨🇴", destination: "Medellín", total: 798, flight: 310, hotel: 288, activities: 200 },
];
---

<Layout
  title="AriTrips — Find the best trip you can take on your budget"
  description="Tell us your budget and we'll show you which destinations actually fit — real flight, hotel, and activity costs, not just a flight price."
  jsonLd={homeJsonLd}
>
  <main class="mx-auto flex max-w-5xl flex-col gap-24 px-6 py-20">
    <!-- 1. Hero, 2. Budget CTA — un mismo bloque visual a propósito (nadie
         quiere un salto grande entre el subtítulo y el botón), pero el CTA
         y la franja de confianza quedan en su propio <div> para que sigan
         siendo dos piezas distinguibles, tal como pidió el usuario. -->
    <section class="flex flex-col items-center gap-6 text-center">
      <p class="text-sm font-medium uppercase tracking-wide text-accent">AriTrips</p>
      <h1 class="max-w-2xl text-4xl font-semibold text-balance text-ink sm:text-5xl">
        Find the best trip you can take on your budget.
      </h1>
      <p class="max-w-xl text-lg text-muted">
        Tell us how much you want to spend. Ari finds destinations where your flight, hotel and
        activities actually fit.
      </p>
      <div class="flex flex-col items-center gap-3">
        <Button href={APP_URL} className="px-6 py-3 text-base">
          Find my trip →
        </Button>
        <p class="text-sm text-muted">
          No booking fees · Compare real travel options · Book directly with trusted providers
        </p>
      </div>
    </section>

    <!-- 3. Example trip / product demo -->
    <section class="flex flex-col items-center gap-6">
      <h2 class="text-xl font-semibold text-ink">✈️ What can Ari find for you?</h2>
      <div class="grid w-full max-w-2xl grid-cols-1 gap-6 sm:grid-cols-2">
        {
          demoTrips.map((trip) => (
            <div class="flex flex-col gap-3 rounded-lg border border-rule bg-surface p-6">
              <p class="text-xs font-medium uppercase tracking-wide text-muted">{trip.budgetLabel}</p>
              <p class="text-lg font-semibold text-ink">
                {trip.flag} {trip.destination} — ${trip.total}
              </p>
              <div class="flex flex-col gap-1 text-sm text-muted">
                <p>✈️ Flight ${trip.flight}</p>
                <p>🏨 Hotel ${trip.hotel}</p>
                <p>🎟️ Activities ${trip.activities}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="text-xs text-muted">Estimates — confirm at booking.</p>
    </section>

    <!-- 4. How Ari works -->
    <section class="flex flex-col gap-6">
      <h2 class="text-center text-2xl font-semibold text-ink">How Ari works</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          steps.map((step) => (
            <div class="flex flex-col items-center gap-2 rounded-lg border border-rule bg-surface p-6 text-center">
              <span class="text-3xl" aria-hidden="true">{step.emoji}</span>
              <h3 class="text-lg font-semibold text-ink">{step.title}</h3>
              <p class="text-sm text-muted">{step.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 5. Popular destinations / trip ideas -->
    <section class="flex flex-col gap-6">
      <h2 class="text-center text-2xl font-semibold text-ink">Trip ideas by city</h2>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm">
        {
          cityLinks.map((link) => (
            <a href={link.href} class="text-muted hover:text-accent">
              Best trips from {link.city}
            </a>
          ))
        }
      </div>
    </section>

    <!-- 6. Blog -->
    <section class="flex flex-col gap-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-ink">From the blog</h2>
        <a href="/blog" class="text-sm font-medium text-accent hover:underline">See all posts →</a>
      </div>
      {
        latestPosts.length === 0 ? (
          <p class="text-sm text-muted">New posts are on their way — check back soon.</p>
        ) : (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            {latestPosts.map((post) => (
              <a href={`/p/${post.id}`} class="flex flex-col gap-3 overflow-hidden rounded-lg border border-rule bg-surface transition-shadow hover:shadow-md">
                <img
                  src={imageProxyUrl(String(post.featuredImageQuery || post.title || post.id), String(post.title ?? post.id))}
                  alt={String(post.title ?? "")}
                  width="400"
                  height="225"
                  class="h-40 w-full object-cover"
                  loading="lazy"
                />
                <div class="flex flex-col gap-1 px-4 pb-4">
                  <h3 class="text-base font-semibold text-ink">{String(post.title ?? post.id)}</h3>
                  {post.description ? <p class="text-sm text-muted">{String(post.description)}</p> : null}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>
    <!-- 7. Footer is outside <main>, below -->
  </main>

  <footer class="bg-[#004bc4] text-white">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-14 text-center">
      <p class="text-lg font-semibold">AriTrips</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href={APP_URL} class="hover:text-highlight">Home</a>
        <a href="/blog" class="hover:text-highlight">Blog</a>
        <a href="/p/about" class="hover:text-highlight">About</a>
        <a href={`${APP_URL}/privacy`} class="hover:text-highlight">Privacy</a>
        <a href={`${APP_URL}/terms`} class="hover:text-highlight">Terms</a>
      </div>
      <p class="max-w-md text-xs text-white/70">
        Some links on this site are affiliate links. We may earn a commission at no extra cost to you.
      </p>
    </div>
  </footer>
</Layout>
