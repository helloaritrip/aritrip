---
// Páginas de contenido armadas con Puck: cada .json en src/content/pages
// se resuelve en build time vía import.meta.glob (Vite), no node:fs — el
// adaptador de Cloudflare corre getStaticPaths dentro de una emulación
// del runtime de Workers incluso en build, donde node:fs no se comporta
// como en Node normal. import.meta.glob es la forma correcta en Astro/Vite
// para esto, funciona igual sin importar el adapter de destino.
import type { Data } from "@measured/puck";
import { Render } from "@measured/puck";
import { config, type Props } from "../../puck/config";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  const modules = import.meta.glob<Data<Props>>("../../content/pages/*.json", {
    eager: true,
    import: "default",
  });
  return Object.entries(modules).map(([filePath, data]) => {
    const slug = filePath.split("/").pop()!.replace(/\.json$/, "");
    return { params: { slug }, props: { data } };
  });
}

const { data } = Astro.props as { data: Data<Props> };
const pageTitle = (data.root.props?.title as string | undefined) ?? "AriTrips";
---

<Layout title={pageTitle} description={pageTitle} showAdRails>
  <Render config={config} data={data} />
</Layout>
