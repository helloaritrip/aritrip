---
// Páginas de contenido armadas con Puck — leídas de Firestore (colección
// `pages`) en cada request, no prerenderizadas en build time (2026-08-07,
// panel de admin). Antes esto leía src/content/pages/*.json vía
// import.meta.glob en build time: "Publicar" desde el editor requería
// bajar un archivo, ubicarlo a mano, commitear y redeployar para que se
// viera. SSR es lo que hace que publicar sea instantáneo de verdad — cero
// <script> igual que antes, esto es fetch server-side, no client-side.
import { env } from "cloudflare:workers";
import type { Data } from "@measured/puck";
import { Render } from "@measured/puck";
import { getDocument } from "@aritrips/data";
import { config, type Props } from "../../puck/config";
import Layout from "../../layouts/Layout.astro";
import { getAdRailsEnabled } from "../../lib/adConfig";

export const prerender = false;

const slug = Astro.params.slug;
const { FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY } = env;

if (!slug || !FIREBASE_CLIENT_EMAIL || !FIREBASE_PRIVATE_KEY) {
  return new Response("Not found", { status: 404 });
}

const credentials = { clientEmail: FIREBASE_CLIENT_EMAIL, privateKey: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n") };

let doc: Record<string, unknown> | null;
try {
  doc = await getDocument("pages", slug, credentials);
} catch {
  // 503 real, no un 404 disfrazado (cambiado 2026-08-15) — antes esto se
  // veía igual que "no encontrado" para el visitante, lo cual era más
  // amable pero le esconde la falla al CDN: stale-if-error (ver el
  // Cache-Control más abajo) solo se activa ante un error real, y con un
  // 404 nunca hay señal de que había una copia buena para servir en su
  // lugar. Con esta URL ya cacheada de antes, Cloudflare debería ni
  // siquiera llegar a mostrar esto casi nunca.
  return new Response("Couldn't load this page right now.", { status: 503 });
}

// Drafts no son públicos — solo visibles desde /ari-admin/edit.
if (!doc || doc.status !== "published" || typeof doc.contentJson !== "string") {
  return new Response("Not found", { status: 404 });
}

let data: Data<Props>;
try {
  data = JSON.parse(doc.contentJson) as Data<Props>;
} catch {
  return new Response("Not found", { status: 404 });
}

// Cache de borde en Cloudflare (2026-08-14) — son las páginas de mayor
// volumen del sitio (48 destinos + 24 hubs + posts), cada una con 2
// lecturas de Firestore (el doc + ad-rails) por visita sin esto. Ver
// dealsCache.ts para el porqué (cuota diaria gratis agotada una vez).
//
// `stale-if-error` (2026-08-15, ver el comentario en deals.astro) — con el
// 503 real de arriba (en vez del 404 disfrazado que había antes), un
// nuevo fallo de Firestore puede seguir sirviendo la última copia buena
// de cada página hasta 24h en vez del error.
// s-maxage subido de 600 a 1800 (2026-08-15, auditoría de lecturas) —
// una página de destino cambia incluso menos seguido que el listado del
// blog una vez publicada; 30 min de caché no le cuesta nada de frescura
// real y son las páginas de mayor volumen del sitio.
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=1800, stale-if-error=86400");

const pageTitle = (data.root.props?.title as string | undefined) || (doc.title as string | undefined) || "AriTrips";
const pageDescription = (doc.description as string | undefined) || pageTitle;

const APP_URL_FOR_IMAGES = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
function imageProxyUrl(query: string, fallback: string): string {
  return `${APP_URL_FOR_IMAGES}/api/image-proxy?q=${encodeURIComponent(query)}&fallback=${encodeURIComponent(fallback)}`;
}

const isBlogPost = doc.template === "blog";
const adRailsEnabled = await getAdRailsEnabled(credentials);

// Imagen para OG/Twitter: la del post de blog, o el fondo del Hero si
// la página tiene uno — mismas fuentes que ya usa la página, sin
// duplicar proveedor de imágenes.
const heroBlock = data.content.find((c) => c.type === "Hero");
const heroImageQuery = (heroBlock?.props as { backgroundImageQuery?: string } | undefined)?.backgroundImageQuery;
const featuredImageQuery = (doc.featuredImageQuery as string | undefined) || heroImageQuery;
const pageImage = featuredImageQuery ? imageProxyUrl(featuredImageQuery, pageTitle) : undefined;

// FAQPage — las páginas hub ya traen preguntas/respuestas reales en el
// bloque FAQAccordion; esto las expone como datos estructurados sin
// escribir contenido nuevo (auditoría SEO, 2026-08-09).
const faqItems = data.content
  .filter((c) => c.type === "FAQAccordion")
  .flatMap((c) => (c.props as { items?: { question: string; answer: string }[] }).items ?? []);

const jsonLd: Record<string, unknown>[] = [];

if (isBlogPost) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: pageTitle,
    description: pageDescription,
    ...(pageImage ? { image: pageImage } : {}),
    ...(doc.publishedAt ? { datePublished: doc.publishedAt } : {}),
    ...(doc.updatedAt ? { dateModified: doc.updatedAt } : {}),
    author: { "@type": "Organization", name: "AriTrips" },
    publisher: { "@type": "Organization", name: "AriTrips", logo: { "@type": "ImageObject", url: "https://aritrips.com/favicon.svg" } },
  });
}

if (faqItems.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  showAdRails={adRailsEnabled}
  type={isBlogPost ? "article" : "website"}
  image={pageImage}
  jsonLd={jsonLd}
>
  <Render config={config} data={data} />
</Layout>
