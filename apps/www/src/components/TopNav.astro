---
// Barra de navegación superior (2026-08-13) — misma barra, mismo estilo y
// mismo contenido que Header.tsx en apps/app, a pedido explícito del
// usuario ("esta barra de menu superior debe ser la misma para el home
// como para el app"). No se puede compartir literalmente un componente
// entre Astro (acá) y React/Next.js (apps/app) sin un esfuerzo de
// arquitectura que no vale la pena para una barra de nav — en cambio, se
// mantienen dos archivos con el mismo HTML/clases a mano. Si se edita
// uno, editar el otro para que no se desalineen.
// "My Favorites" y "Join AriTrips" llevan a app.aritrips.com/favorites y
// /join — cuentas de usuario vía Google Sign-In (ver AuthProvider.tsx en
// apps/app). Deliberadamente estático (sin JS): no sabe si ya hay sesión
// iniciada, mismo criterio ahora en los dos sitios (Header.tsx en
// apps/app tampoco cambia según sesión, a propósito, para que las dos
// barras se vean siempre iguales).
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
---

<header class="sticky top-0 z-30 rounded-b-3xl bg-surface shadow-sm">
  <!-- Grid de 3 columnas (1fr / auto / 1fr), no flex justify-between —
       mismo motivo que Header.tsx en apps/app: con justify-between el nav
       del medio quedaba desplazado hacia la izquierda porque el bloque de
       la derecha pesa más que el logo (reportado 2026-08-13). -->
  <div class="mx-auto grid max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-3">
    <a href="/" class="flex w-fit items-center gap-2 justify-self-start">
      <img src="/ari/mascot.png" alt="" class="h-9 w-9 rounded-xl object-cover" width="36" height="36" />
      <span class="text-xl font-extrabold tracking-tight">
        <span class="text-ink">ari</span><span class="text-highlight">trips</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-ink justify-self-center md:flex">
      <a href={APP_URL} class="flex items-center gap-1.5 hover:text-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 12h18" />
        </svg>
        Trips
      </a>
      <a href="/deals" class="flex items-center gap-1.5 hover:text-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M3 11.5V5a2 2 0 0 1 2-2h6.5a2 2 0 0 1 1.42.59l8 8a2 2 0 0 1 0 2.82l-6.59 6.59a2 2 0 0 1-2.82 0l-8-8A2 2 0 0 1 3 11.5Z" />
          <circle cx="8" cy="8" r="1.25" fill="currentColor" stroke="none" />
        </svg>
        Deals
      </a>
      <a href="/blog" class="flex items-center gap-1.5 hover:text-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M9 4 3 6.5v13L9 17l6 3 6-2.5v-13L15 7 9 4Z" /><path d="M9 4v13" /><path d="M15 7v13" />
        </svg>
        Travel Guide
      </a>
      <a href={`${APP_URL}/favorites`} class="flex items-center gap-1.5 hover:text-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M12 20s-7-4.4-9.5-8.8C.9 8 2.4 4.5 5.8 4.1c1.9-.2 3.6.8 4.7 2.4a.6.6 0 0 0 1 0c1.1-1.6 2.8-2.6 4.7-2.4 3.4.4 4.9 3.9 3.3 7.1C19 15.6 12 20 12 20Z" />
        </svg>
        My Favorites
      </a>
    </nav>

    <div class="flex items-center justify-end gap-3 justify-self-end">
      <!-- Decorativo por ahora — no hay sistema real de idiomas/monedas
           todavía, mismo criterio que otros "reservado, sin implementar"
           del proyecto (ver Roadmap). -->
      <button
        type="button"
        disabled
        class="hidden items-center gap-1 rounded-full border border-rule px-3 py-1.5 text-xs font-medium text-muted sm:flex"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
          <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z" />
        </svg>
        USD / EN
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <a
        href={`${APP_URL}/join`}
        class="shrink-0 rounded-full bg-muted/15 px-4 py-2 text-sm font-medium text-ink hover:bg-muted/25"
      >
        Join AriTrips
      </a>
    </div>
  </div>
</header>
