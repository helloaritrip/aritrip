---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Reserva el espacio para 2 rieles verticales de anuncio (formato
  // "skyscraper", 160x600) a los costados del contenido — layout listo,
  // sin ningún script de anuncio real todavía (pendiente de aprobación de
  // Google AdSense, ver memoria/chat 2026-08-07). Se ocultan por completo
  // debajo de 1400px de ancho, como cualquier skyscraper real: no hay
  // espacio para ellos en pantallas angostas ni en mobile.
  showAdRails?: boolean;
  // Open Graph / Twitter Card — imagen absoluta y tipo. Si no se pasa
  // imagen, se usa una genérica del proxy de imágenes propio (nunca
  // fotos propias almacenadas, ver System Architecture).
  image?: string;
  type?: "website" | "article";
  // Datos estructurados (JSON-LD) específicos de la página — cada
  // entrada se serializa en su propio <script type="application/ld+json">.
  jsonLd?: Record<string, unknown>[];
}

const SITE_URL = "https://aritrips.com";
const APP_URL_FOR_IMAGES = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
const DEFAULT_OG_IMAGE = `${APP_URL_FOR_IMAGES}/api/image-proxy?q=${encodeURIComponent("tropical beach aerial travel")}&fallback=${encodeURIComponent("travel destination")}`;

const { title, description, showAdRails = false, image = DEFAULT_OG_IMAGE, type = "website", jsonLd = [] } = Astro.props;

// Canonical siempre sobre el dominio apex, sin barra final (salvo la
// home) — el middleware ya redirige www→apex y quita la barra final en
// las respuestas, pero esta etiqueta cubre además cualquier variante
// que Google haya indexado antes de ese cambio.
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, "") : rawPath;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="AriTrips" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />)}

    {/* Google AdSense — verificación de sitio (2026-08-07). No es un secreto,
       va público en el HTML de cualquier sitio con AdSense. */}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7378357249241251"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="min-h-screen bg-bg text-ink antialiased">
    {
      showAdRails ? (
        <div class="mx-auto flex max-w-[1400px] justify-center gap-5">
          <aside class="sticky top-5 hidden h-[600px] w-[160px] shrink-0 flex-col items-center justify-center rounded-lg border-2 border-dashed border-rule px-3 text-center text-xs text-muted min-[1400px]:flex">
            Ad space reserved
            <br />
            160×600
          </aside>
          <div class="min-w-0 flex-1">
            <slot />
          </div>
          <aside class="sticky top-5 hidden h-[600px] w-[160px] shrink-0 flex-col items-center justify-center rounded-lg border-2 border-dashed border-rule px-3 text-center text-xs text-muted min-[1400px]:flex">
            Ad space reserved
            <br />
            160×600
          </aside>
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>
